---
// ===== src/layouts/Base.astro =====
/* 
  - FIX: Re-enabled the manifest link now that the file exists.
  - ADDED: A global script to handle JavaScript-triggered downloads.
*/

import '../styles/global.css';
import { getSettings } from '../services/api';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import PopupBanner from '../components/PopupBanner.astro';
import SocialSidebar from '../components/SocialSidebar.astro';
import SplashVideo from '../components/SplashVideo.astro';
import { useI18n, locales, createPath, getPathWithoutLocale } from '../i18n';
import { toPlainText } from '../lib/plainText';
import { resolveExtraSocialLinks, isSocialLinkActive } from '../lib/socialPlatforms';
import { getMenuPages } from '../lib/menuPages';
import { buildOrganizationLd } from '../lib/orgSchema';
// Link builder that leaves "#section" links alone (i18n's createPath adds a trailing slash: "/#how/")
import { createPath as linkPath } from '../lib/paths';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  prevUrl?: string;
  nextUrl?: string;
  /** Languages this page really exists in. Omit for pages that always exist in every locale. */
  alternateLangs?: ('en' | 'hi')[];
  rssUrl?: string;
  lang?: 'en' | 'hi';
  focusKeyword?: string;
  robotsIndex?: boolean;
  robotsFollow?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  twitterTitle?: string;
  twitterDescription?: string;
}

const {
  title = 'Starsuu7 — Teen Patti & Rummy Real Cash App | UU7 777',
  description: pageDescription = 'Play Teen Patti & Rummy on Starsuu7 (UU7 • 777). Secure payments, instant withdrawals, 24/7 support. India’s trusted real-cash gaming app. 18+ only, play responsibly.',
  canonical,
  jsonLd,
  prevUrl,
  nextUrl,
  alternateLangs,
  rssUrl,
  lang: langProp,
  focusKeyword = '',
  robotsIndex = true,
  robotsFollow = true,
  ogTitle = '',
  ogDescription = '',
  ogImage = '',
  twitterTitle = '',
  twitterDescription = '',
  schemaMarkup,
} = Astro.props;

// CMS excerpts are markdown; meta tags must be plain text.
const metaDescription = toPlainText(pageDescription);
const metaOgDescription = toPlainText(ogDescription);
const metaTwitterDescription = toPlainText(twitterDescription);

const siteBase = new URL('/', Astro.site).toString();
const pathname = Astro.url.pathname;
const url = canonical ?? new URL(pathname, Astro.site).toString();
// Pages under /hi/ are Hindi even if they forget to pass `lang`.
const lang: 'en' | 'hi' = langProp ?? (/^\/hi(\/|$)/.test(pathname) ? 'hi' : 'en');
const pageLocale = lang === 'hi' ? 'hi_IN' : 'en_IN';

const pathWithoutLocale = getPathWithoutLocale(pathname);

// hreflang only for languages this page really exists in (never point at a 404)
const hreflangLocales = locales.filter((l) => !alternateLangs || alternateLangs.includes(l as 'en' | 'hi'));
const hreflangDefault = hreflangLocales.includes('en' as any) ? 'en' : hreflangLocales[0];

const menuLinks = [
  { href: linkPath('/#how', lang), label: 'How to Play' },
  { href: linkPath('/#promos', lang), label: 'Promotions' },
  { href: linkPath('/about/', lang), label: 'About Us' },
  { href: linkPath('/faq/', lang), label: 'FAQ' },
  { href: linkPath('/blog/', lang), label: 'Blog' },
  // Custom pages ticked "Show in the website menu" in the admin
  ...(await getMenuPages(lang)),
];
const downloadLink = linkPath('/download/', lang);

const settings = await getSettings(); 
const brandName = settings?.siteName || 'Starsuu7';
const logoUrl = new URL(settings?.logoUrl || '/logo.webp', Astro.site).toString();

// Technical SEO variables
const googleAnalyticsId = settings?.googleAnalyticsId || 'G-NSX5MEH182';
const googleSearchConsoleVerification = settings?.googleSearchConsoleVerification || '';
const ahrefsVerification = settings?.ahrefsVerification || '9b4a068be0accae70bb69802a875d1f5d6f987bb64e6f428005d97af07a52f2c';
const customHeaderScripts = settings?.customHeaderScripts || '';
const customFooterScripts = settings?.customFooterScripts || '';

// schemaMarkup is CMS-supplied JSON-LD. It must never be trusted as raw HTML/script —
// only accept it if it parses as JSON, then re-serialize and escape "<" so it can't
// break out of the <script> tag it's rendered into.
let safeSchemaMarkup: string | null = null;
if (schemaMarkup) {
  try {
    safeSchemaMarkup = JSON.stringify(JSON.parse(schemaMarkup)).replace(/</g, '\\u003c');
  } catch {
    safeSchemaMarkup = null;
  }
}
const contentRating = '18+';

let release: Record<string, string> = {};
try {
  release = (await import('../data/release.json')).default as Record<string, string>;
} catch {}

const downloadUrl = settings?.apkDownloadLink || release.downloadUrl || '#';
const softwareVersion = release.version ?? '1.0.0';
const fileSize = release.size ?? '22.1 MB';
const updatedHuman = release.updated ?? '2025-10-03';
const dateModifiedISO = new Date(updatedHuman).toISOString();

// Profiles outside their admin schedule window are left out (Footer/Sidebar ticks don't matter here)
const liveFixed = (url: string | undefined, key: string) =>
  isSocialLinkActive(settings?.socialLinkDisplay?.[key]) ? url : undefined;
const sameAs = [...new Set([
  liveFixed(settings?.twitterUrl, 'twitter'),
  liveFixed(settings?.facebookUrl, 'facebook'),
  liveFixed(settings?.instagramUrl, 'instagram'),
  liveFixed(settings?.youtubeUrl, 'youtube'),
  liveFixed(settings?.telegramUrl, 'telegram'),
  liveFixed(settings?.whatsappUrl, 'whatsapp'),
  ...resolveExtraSocialLinks(settings?.extraSocialLinks).map((l) => l.href)
].filter(Boolean) as string[])];

// Name, other names and support link are editable in Admin > Site Settings > "Organization Info for Google"
const ldOrganization = buildOrganizationLd({
  settings,
  brandName,
  siteBase,
  logoUrl,
  sameAs,
  telegramUrl: liveFixed(settings?.telegramUrl, 'telegram')
});
const ldWebSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: brandName,
  url: siteBase,
  inLanguage: 'en-IN'
  // No SearchAction: the site has no /search page (it 404s)
};
const ldMobileApp = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: brandName,
  operatingSystem: 'Android',
  applicationCategory: 'GameApplication',
  inLanguage: 'en-IN',
  url: siteBase,
  image: logoUrl,
  contentRating,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR', availability: 'https://schema.org/InStock', url: downloadUrl },
  downloadUrl,
  softwareVersion,
  fileSize,
  dateModified: dateModifiedISO,
  publisher: { '@type': 'Organization', name: brandName, url: siteBase, logo: { '@type': 'ImageObject', url: logoUrl } }
};
const ldSoftware = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: brandName,
  operatingSystem: 'Android',
  applicationCategory: 'GameApplication',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR', url: downloadUrl },
  downloadUrl
};
const ldBlocks: Array<Record<string, any>> = [ ldOrganization, ldWebSite, ldMobileApp, ldSoftware ];
if (jsonLd) {
  if (Array.isArray(jsonLd)) {
    ldBlocks.push(...jsonLd);
  } else {
    ldBlocks.push(jsonLd);
  }
} else {
  ldBlocks.push({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description: metaDescription,
    url,
    isPartOf: { '@type': 'WebSite', url: siteBase, name: brandName },
    inLanguage: 'en-IN'
  });
}
---

<!DOCTYPE html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={focusKeyword ? `${focusKeyword}, Starsuu7, UU7, 777, Starsuu7 app, real cash games` : 'Starsuu7, UU7, 777, Starsuu7 app, Starsuu7 APK, Teen Patti app, Rummy app, real cash games India, Teen Patti real money, Rummy real money, Starsuu7 download'} />

    <link rel="canonical" href={url} />
    
    {hreflangLocales.map(locale => (
      <link rel="alternate" hreflang={locale} href={new URL(createPath(pathWithoutLocale, locale), Astro.site).toString()} />
    ))}
    {hreflangDefault && <link rel="alternate" hreflang="x-default" href={new URL(createPath(pathWithoutLocale, hreflangDefault), Astro.site).toString()} />}


    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    {rssUrl && <link rel="alternate" type="application/rss+xml" title="RSS Feed" href={rssUrl} />}

    <meta name="theme-color" content="#f97316" />
    <meta name="robots" content={`${robotsIndex ? 'index' : 'noindex'},${robotsFollow ? 'follow' : 'nofollow'},max-snippet:-1,max-image-preview:large,max-video-preview:-1`} />

    <link rel="icon" href="/logo.webp" type="image/webp" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />


    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap" rel="stylesheet" />

    <meta property="og:site_name" content={brandName} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={pageLocale} />
    <meta property="og:title" content={ogTitle || title} />
    <meta property="og:description" content={metaOgDescription || metaDescription} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage || new URL('/wordpress/STARSUU7-Game.webp', Astro.site).toString()} />
    <meta property="og:image:alt" content="Starsuu7 — Teen Patti & Rummy" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={twitterTitle || ogTitle || title} />
    <meta name="twitter:description" content={metaTwitterDescription || metaOgDescription || metaDescription} />
    <meta name="twitter:image" content={ogImage || new URL('/wordpress/STARSUU7-Game.webp', Astro.site).toString()} />
    <meta name="twitter:site" content="@starsuu7" />

    {ahrefsVerification && <meta name="ahrefs-site-verification" content={ahrefsVerification} />}
    {googleSearchConsoleVerification && <meta name="google-site-verification" content={googleSearchConsoleVerification} />}

    <!-- No cookies: storage consent is denied before any Google tag loads, so Analytics (this tag and any
         added through Settings -> header scripts) runs cookieless: no _ga cookies, no stored client id. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('consent', 'default', { ad_storage: 'denied', analytics_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
    </script>

    {googleAnalyticsId && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
    )}
    {googleAnalyticsId && (
      <script is:inline define:vars={{ googleAnalyticsId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', googleAnalyticsId, { send_page_view: true });
      </script>
    )}

    {customHeaderScripts && <Fragment set:html={customHeaderScripts} />}

    <script type="application/ld+json" set:html={JSON.stringify(ldBlocks).replace(/</g, '\\u003c')} />
    {safeSchemaMarkup && (
      <script type="application/ld+json" set:html={safeSchemaMarkup} />
    )}
  </head>

  <body>
    {settings?.showSplashVideo && settings?.splashVideoUrl && (
      <SplashVideo videoUrl={settings.splashVideoUrl} lang={lang} />
    )}

    <a id="top" href="#main" class="skiplink">Skip to content</a>

    <main id="main">
      <slot />
    </main>

    <div id="global-mobile-menu" aria-hidden="true">
      <div class="gmm-backdrop" data-gmm-close tabindex="-1" aria-hidden="true"></div>
      <aside class="gmm-sheet" role="dialog" aria-modal="true" aria-labelledby="gmm-title">
        <header class="gmm-head">
          <h2 id="gmm-title">Menu</h2>
          <button class="gmm-close" type="button" aria-label="Close menu" data-gmm-close>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </header>
        <nav class="gmm-nav" role="navigation" aria-label="Mobile">
          {menuLinks.map(link => (
            <a href={link.href} class="gmm-link" data-gmm-link>{link.label}</a>
          ))}
          <a href={downloadLink} class="gmm-link gmm-download" data-gmm-link>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17V3"/><path d="m6 11 6 6 6-6"/><path d="M19 21H5"/></svg>
            Download App
          </a>
        </nav>
      </aside>
    </div>

    <LanguageSwitcher />

    <SocialSidebar />

    <PopupBanner lang={lang} />

    <script is:inline>
      (function () {
        const portal = document.getElementById('global-mobile-menu');
        const sheet = portal && portal.querySelector('.gmm-sheet');
        const focusablesSel = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
        let lastActive = null;
        function trapFocus(e) {
          if (!portal || portal.getAttribute('aria-hidden') === 'true') return;
          const nodes = sheet ? sheet.querySelectorAll(focusablesSel) : [];
          const first = nodes[0];
          const last = nodes[nodes.length - 1];
          if (!first || !last) return;
          if (e.key === 'Tab') {
            if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); } 
            else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
          } else if (e.key === 'Escape') {
            e.preventDefault();
            if (window.AppMenu && typeof window.AppMenu.close === 'function') window.AppMenu.close();
          }
        }
        function openMenu() {
          if (!portal) return;
          lastActive = document.activeElement || null;
          portal.setAttribute('aria-hidden', 'false');
          document.documentElement.style.overflow = 'hidden';
          document.body.style.touchAction = 'none';
          if (sheet && typeof sheet.focus === 'function') sheet.focus();
          document.addEventListener('keydown', trapFocus);
        }
        function closeMenu() {
          if (!portal) return;
          portal.setAttribute('aria-hidden', 'true');
          document.documentElement.style.overflow = '';
          document.body.style.touchAction = '';
          document.removeEventListener('keydown', trapFocus);
          try {
            if (lastActive && 'focus' in lastActive && typeof lastActive.focus === 'function') {
              (lastActive).focus();
            }
          } catch (_) {}
        }
        window.AppMenu = { open: openMenu, close: closeMenu, toggle: () => (portal && portal.getAttribute('aria-hidden') === 'true' ? openMenu() : closeMenu()) };
        window.addEventListener('open-global-menu', () => openMenu());
        document.addEventListener('click', (e) => {
          const t = e.target;
          if (!(t instanceof Element)) return;
          if (t.closest('[data-gmm-close]')) { e.preventDefault(); closeMenu(); }
          if (t.closest('[data-gmm-link]')) { closeMenu(); }
        }, { passive: false });
        // ---- LiveChat ----
        // Phones only. LiveChat pops up a greeting card ("Hi, let us know if you have any questions") and, later, a
        // new-message preview over the middle / bottom of the screen. They cover buttons and the tab bar until the
        // visitor closes them. 1) The greeting is cancelled as soon as LiveChat announces it, so the chat box goes
        // back to the round 84px button. 2) The preview (about 320x116, with the button in its corner) is clipped down
        // to that button (class uu7-chat-popup-clip, defined in global.css). 3) LiveChat puts its round button in the
        // bottom-right corner, right on top of the FAQ tab of the bottom tab bar, so FAQ could not be tapped. While the
        // chat is not open, the box is lifted to sit just above the tab bar (class uu7-chat-lift, with --uu7-chat-lift =
        // the tab bar's height; pages without a tab bar are left alone). An open chat window (full screen) and
        // everything on larger screens are left alone.
        const lcPhone = window.matchMedia('(max-width: 767px)');
        function tabBarHeight() {
          const bar = Array.from(document.querySelectorAll('.tabbar')).find(function (n) { return n.offsetHeight > 0; });
          return bar ? bar.offsetHeight : 0;
        }
        function watchChatBox(box) {
          function sync() {
            const w = box.offsetWidth, h = box.offsetHeight;
            const isButton = w <= 100 && h <= 100;
            const isOpen = w >= window.innerWidth * 0.9 && h >= window.innerHeight * 0.9;
            box.classList.toggle('uu7-chat-popup-clip', lcPhone.matches && !isButton && !isOpen && h <= 200);
            // Never lift something that would then stick out at the top of the screen.
            const lift = lcPhone.matches && !isOpen ? tabBarHeight() : 0;
            const doLift = lift > 0 && h + lift <= window.innerHeight;
            if (doLift) document.documentElement.style.setProperty('--uu7-chat-lift', lift + 'px');
            box.classList.toggle('uu7-chat-lift', doLift);
          }
          new MutationObserver(sync).observe(box, { attributes: true, attributeFilter: ['style'] });
          window.addEventListener('resize', sync);
          sync();
        }
        let lcLoaded = false;
        function loadLiveChat() {
          if (lcLoaded) return;
          lcLoaded = true;
          window.__lc = window.__lc || {};
          window.__lc.license = 18988469;
          window.__lc.integration_name = 'manual_channels';
          window.__lc.product_name = 'livechat';
          // LiveChat's own start-up snippet first creates window.LiveChatWidget, a small queue that tracking.js takes
          // over once it has loaded. Without it the widget waits about 3 seconds, during which an invisible
          // full-screen layer sits on top of the page and swallows taps (Download button, tab bar...).
          const lw = { _q: [], _h: null, _v: '2.0' };
          const lwQueue = function (args) { return lw._h ? lw._h.apply(null, args) : lw._q.push(args); };
          ['on', 'once', 'off', 'call'].forEach(function (m) { lw[m] = function () { lwQueue([m, [].slice.call(arguments)]); }; });
          lw.get = function () {
            if (!lw._h) throw new Error("[LiveChatWidget] You can't use getters before load.");
            return lwQueue(['get', [].slice.call(arguments)]);
          };
          const lcApi = window.LiveChatWidget || (window.LiveChatWidget = lw);
          // The greeting arrives as a "new_event" that carries a greeting object; hiding it then means it is never drawn.
          // "greeting_displayed" is the fallback if it gets drawn anyway.
          lcApi.on('new_event', function (ev) { if (lcPhone.matches && ev && ev.greeting) lcApi.call('hide_greeting'); });
          lcApi.on('greeting_displayed', function () { if (lcPhone.matches) lcApi.call('hide_greeting'); });
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://cdn.livechatinc.com/tracking.js';
          document.head.appendChild(s);
          // Pick up the chat box as soon as LiveChat adds it to the page (give up after a minute).
          let lcTries = 0;
          const lcTimer = setInterval(function () {
            const box = document.getElementById('chat-widget-container');
            if (box) { clearInterval(lcTimer); watchChatBox(box); }
            else if (++lcTries > 240) clearInterval(lcTimer);
          }, 250);
        }
        function onFirstIntent() {
          loadLiveChat();
          window.removeEventListener('pointerdown', onFirstIntent);
          window.removeEventListener('keydown', onFirstIntent);
          window.removeEventListener('scroll', onFirstIntent, { passive: true });
        }
        window.addEventListener('pointerdown', onFirstIntent, { passive: true });
        window.addEventListener('keydown', onFirstIntent);
        window.addEventListener('scroll', onFirstIntent, { passive: true });
        (window.requestIdleCallback || ((cb) => setTimeout(cb, 1500)))(() => {
          if (!lcLoaded) loadLiveChat();
        });
      })();

      // The home page renders its desktop and mobile layouts with the same section ids (#how, #promos,
      // #about, #download). The browser jumps to the first copy, which is hidden on phones, so "/#how"
      // did nothing there. When the first copy is hidden, jump to the visible one instead.
      (function () {
        function visibleTarget(hash) {
          if (!hash || hash.length < 2) return null;
          var id;
          try { id = decodeURIComponent(hash.slice(1)); } catch (_) { return null; }
          var first = document.getElementById(id);
          if (!first || first.getClientRects().length) return null; // missing, or the browser's own jump works
          var all = document.querySelectorAll('[id="' + id.replace(/["\\]/g, '\\$&') + '"]');
          for (var i = 0; i < all.length; i++) if (all[i].getClientRects().length) return all[i];
          return null;
        }
        function jump(hash, smooth) {
          var el = visibleTarget(hash);
          if (!el) return false;
          var bar = document.querySelector('.app-bar'); // sticky mobile top bar
          var offset = bar && bar.getClientRects().length ? bar.getBoundingClientRect().height + 8 : 0;
          window.scrollTo({ top: Math.max(0, el.getBoundingClientRect().top + window.scrollY - offset), behavior: smooth ? 'smooth' : 'auto' });
          return true;
        }
        if (location.hash) {
          jump(location.hash, false);
          window.addEventListener('load', function () { jump(location.hash, false); }); // after images settle
        }
        window.addEventListener('hashchange', function () { jump(location.hash, true); });
        // A link to the hash already in the address bar fires no hashchange, so handle that click here
        document.addEventListener('click', function (e) {
          var a = e.target instanceof Element ? e.target.closest('a[href*="#"]') : null;
          if (!a || e.defaultPrevented || a.pathname !== location.pathname || a.hash !== location.hash) return;
          if (jump(a.hash, true)) e.preventDefault();
        });
      })();

      // Keep the address bar clean on the home pages: after a section link ("About Us" -> /#about, #how, #promos,
      // #download ...) has scrolled the page, drop the "#section" from the URL. Only on "/" and "/hi/" and only when
      // the hash really is a section on the page, so FAQ links such as /faq/#payments keep their shareable "#".
      // replaceState does not scroll and does not fire hashchange, so nothing moves; it waits until the scroll has
      // stopped (the jump above can be smooth, and the browser may re-scroll while images load).
      (function () {
        var HOME = { '/': true, '/hi/': true };
        var timer;
        function cleanNow() {
          if (!location.hash || !HOME[location.pathname] || !window.history || !history.replaceState) return;
          var id;
          try { id = decodeURIComponent(location.hash.slice(1)); } catch (_) { return; }
          if (!id || !document.getElementById(id)) return; // not one of our sections: leave it alone
          history.replaceState(history.state, '', location.pathname + location.search);
        }
        function cleanSoon() {
          clearTimeout(timer);
          var last = -1, waited = 0;
          (function tick() {
            var y = window.scrollY;
            waited += 150;
            if ((y === last && waited >= 450) || waited >= 3000) { cleanNow(); return; }
            last = y;
            timer = setTimeout(tick, 150);
          })();
        }
        window.addEventListener('hashchange', cleanSoon);
        if (document.readyState === 'complete') { if (location.hash) cleanSoon(); }
        else window.addEventListener('load', function () { if (location.hash) cleanSoon(); });
      })();

      // --- NEW SCRIPT FOR JS-TRIGGERED DOWNLOADS ---
      document.addEventListener('click', function(e) {
        const target = e.target.closest('[data-js-download]');
        if (target && target.dataset.url) {
          e.preventDefault(); // Prevent default action if it's an <a> tag
          window.location.href = target.dataset.url;
        }
      }, { passive: false });
    </script>

    {customFooterScripts && <Fragment set:html={customFooterScripts} />}
  </body>
</html>

<style>
  .skiplink {
    position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;
  }
  .skiplink:focus {
    left: 12px; top: 12px; width: auto; height: auto; background:#fff; color:#000;
    padding:8px 12px; border-radius:8px; z-index: 12000; text-decoration: none;
  }
  #global-mobile-menu { position: fixed; inset: 0; z-index: 11000; display: grid; grid-template-rows: 1fr; pointer-events: none; }
  #global-mobile-menu[aria-hidden="true"] { visibility: hidden; opacity: 0; }
  #global-mobile-menu[aria-hidden="false"] { visibility: visible; opacity: 1; pointer-events: auto; }
  .gmm-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,.45); }
  .gmm-sheet {
    position: fixed; inset-inline: 0; bottom: 0;
    transform: translateY(100%);
