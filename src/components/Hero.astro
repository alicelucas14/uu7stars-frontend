---
// src/components/Hero.astro — REFACTORED for i18n
import type { Locale } from '../i18n';
import { useTranslations } from '../lib/i18n';
import { createPath } from '../lib/paths';

// --- ADDED: Language props and translation function ---
interface Props {
  lang?: Locale;
  asH1?: boolean;
}
const { lang = 'en', asH1 = true } = Astro.props as Props;
const t = useTranslations(lang);
// ---

// Use a single, high-quality hero image for LCP.
const HERO_WEBP = "/wordpress/STARSUU7-Game.webp";
---

<section class="hero" role="region" aria-label="Starsuu7 introduction">
  <div class="container hero__inner">
    <div class="hero__copy">
      {/* UPDATED: Use the 't' function for the headline */}
      {asH1 ? <h1>{t('hero.h1')}</h1> : <div class="h1-alt" role="heading" aria-level="1">{t('hero.h1')}</div>}

      {/* UPDATED: Use the 't' function with set:html for rich text */}
      <p class="lead" set:html={t('hero.lead')}></p>

      <ul class="hero__badges" aria-label={t('hero.ctaAriaLabel')}>
        {(t('hero.badges') as string[]).map((b, i) => (
          <li>
            <span class="badge-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                {i === 0 && (<><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></>)}
                {i === 1 && (<><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></>)}
                {i === 2 && (<><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/></>)}
              </svg>
            </span>
            {b}
          </li>
        ))}
      </ul>

      <div class="cta-group">
        {/* UPDATED: Use the 't' function for the aria-label */}
        <a href={createPath('/download/', lang)} class="hero-cta-unit" aria-label={t('hero.ctaAriaLabel')}>
          <div class="btn-hero-top">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" x2="12" y1="15" y2="3"/>
            </svg>
            {/* UPDATED: Use the 't' function for the button text */}
            <span>{t('hero.ctaButton')}</span>
          </div>
          <div class="btn-hero-bonus">
            {/* UPDATED: Use the 't' function for the bonus text */}
            {t('hero.ctaBonus')}
          </div>
        </a>
      </div>
    </div>

    <div class="art-wrap">
      <picture class="hero-art-picture">
        <source srcset={`${HERO_WEBP} 1x`} type="image/webp" />
        <img
          class="hero__art"
          src={HERO_WEBP}
          alt={t('hero.imageAlt')}
          decoding="async"
          fetchpriority="high"
          loading="eager"
          width="1160" height="1000"
          sizes="(max-width: 980px) 90vw, 44vw"
        />
      </picture>
      <noscript>
        <img class="hero__art noscript" src={HERO_WEBP} width="1160" height="1000" alt={t('hero.imageAlt')} />
      </noscript>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: 48px 104px;
    color: #fff;
    background:
      radial-gradient(55% 70% at 88% 18%, rgba(255, 244, 190, .55), transparent 62%),
      radial-gradient(45% 55% at 6% 92%, rgba(255, 255, 255, .16), transparent 60%),
      linear-gradient(158deg, var(--brand-orange) 0%, #fb8c1d 42%, var(--brand-gold) 100%);
    border-bottom: 1px solid rgba(0,0,0,.08);
  }
  /* soft dotted texture, fading out towards the bottom */
  .hero::before {
    content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .5;
    background-image: radial-gradient(rgba(255,255,255,.35) 1.2px, transparent 1.4px);
    background-size: 26px 26px;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 75%);
    mask-image: linear-gradient(180deg, #000 0%, transparent 75%);
  }
  @media (min-width: 768px) { .hero { padding-top: 136px; } } /* the header sits on top of the hero here */
  /* phones: the top bar sits on the hero too */
  @media (max-width: 767px) { .hero { padding-top: calc(104px + env(safe-area-inset-top)); } }

  .hero__inner { position: relative; display: grid; gap: 48px; grid-template-columns: 1.1fr .9fr; align-items: center; }

  .hero__copy h1, .hero__copy .h1-alt {
    margin: 0 0 16px;
    font-size: clamp(34px, 4.6vw, 60px);
    line-height: 1.06;
    letter-spacing: -.02em;
    font-weight: 800;
    color: #fff;
    text-shadow: 0 2px 14px rgba(124, 45, 18, .25);
  }
  .lead { max-width: 56ch; margin: 0; font-size: clamp(16px, 1.25vw, 18px); line-height: 1.65; color: rgba(255,255,255,.95); text-shadow: 0 1px 8px rgba(124, 45, 18, .18); }

  /* trust line: plain text with small gold icons and hairline dividers, no boxes */
  .hero__badges { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 0; margin: 20px 0 0; padding: 0; }
  .hero__badges li {
    position: relative; display: inline-flex; align-items: center; gap: 8px;
    padding: 0 18px; font-size: 13px; font-weight: 700; letter-spacing: .2px; line-height: 1.2; color: #fff;
    text-shadow: 0 1px 8px rgba(124, 45, 18, .3);
  }
  .hero__badges li:first-child { padding-left: 0; }
  .hero__badges li + li::before { content: ""; position: absolute; left: 0; top: 50%; width: 1px; height: 16px; transform: translateY(-50%); background: rgba(255,255,255,.5); }
  .badge-ico { display: inline-grid; place-items: center; flex: none; color: #fff7c2; filter: drop-shadow(0 1px 3px rgba(124, 45, 18, .35)); }
  .badge-ico svg { width: 17px; height: 17px; }

  .cta-group { display: block; margin-top: 30px; }
  .hero-cta-unit {
    display: inline-grid; grid-template-rows: auto auto; justify-items: stretch;
    text-decoration: none; cursor: pointer; outline: none;
    filter: drop-shadow(0 14px 22px rgba(154, 52, 18, .45));
    transition: transform .2s ease-out, filter .2s ease-out;
  }
  .hero-cta-unit:hover { transform: translateY(-3px); filter: drop-shadow(0 18px 28px rgba(154, 52, 18, .5)) brightness(1.04); }
  .hero-cta-unit:focus-visible { outline: 3px solid #fff; outline-offset: 5px; border-radius: 18px; }
  /* brand gold button with a white bonus strip underneath */
  .btn-hero-top {
    position: relative; isolation: isolate; overflow: hidden;
    display: inline-flex; align-items: center; justify-content: center; gap: 12px;
    padding: 17px 36px; width: 100%;
    font-weight: 850; font-size: 18px; letter-spacing: .5px; text-transform: uppercase;
    color: #431407;
    background: linear-gradient(180deg, #fff3a3 0%, var(--brand-gold) 48%, #f59e0b 100%);
    border-radius: 18px 18px 0 0;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.85), inset 0 -2px 0 rgba(180, 83, 9, .25);
  }
  .btn-hero-top svg { color: #9a3412; }
  .btn-hero-top::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(110deg, transparent 0%, rgba(255,255,255,.6) 22%, transparent 42%);
    transform: translateX(-120%); transition: transform .7s ease;
  }
  .hero-cta-unit:hover .btn-hero-top::after { transform: translateX(120%); }
  .btn-hero-bonus {
    padding: 10px 20px; text-align: center; font-size: 14px; font-weight: 700;
    color: #9a3412; background: #fff; border-radius: 0 0 18px 18px;
  }

  .art-wrap { position: relative; overflow: clip; display: grid; place-items: end center; }
  .art-wrap::before {
    content: ""; position: absolute; width: min(86%, 440px); aspect-ratio: 1; border-radius: 50%; bottom: 4%;
    background: radial-gradient(circle at 50% 40%, rgba(255,255,255,.55), rgba(255,255,255,.12) 62%, transparent 70%);
    box-shadow: 0 0 0 1px rgba(255,255,255,.25), 0 0 0 26px rgba(255,255,255,.07);
    z-index: 0;
  }
  .hero-art-picture { display: block; position: relative; z-index: 1; }
  .hero__art {
    display: block;
    height: clamp(340px, 42vw, 500px);
    width: clamp(300px, 44vw, 580px);
    max-width: 100%;
    border-radius: 24px;
    object-fit: cover; object-position: top center;
    transform: translateY(26px) scale(1.08);
    transition: transform .6s cubic-bezier(.22,1,.36,1);
    filter: drop-shadow(0 22px 28px rgba(124, 45, 18, .3));
    animation: hero-float 7s ease-in-out infinite;
  }
  .art-wrap:hover .hero__art { transform: translateY(14px) scale(1.11); }
  @keyframes hero-float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -10px; } }

  /* phones: three equal columns, icon above the text, hairline dividers; clear of the floating share bar and language tab */
  @media (max-width: 560px) {
    .hero__badges { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; max-width: 300px; margin-inline: auto; }
    .hero__badges li, .hero__badges li:first-child { flex-direction: column; justify-content: flex-start; gap: 6px; padding: 2px 6px; font-size: 11.5px; text-align: center; }
    .hero__badges li + li::before { height: 34px; top: 50%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-cta-unit, .btn-hero-top::after, .hero__art { transition: none !important; animation: none !important; transform: none !important; }
  }
  @media (max-width: 980px) {
    .hero { padding-bottom: 92px; }
    .hero__inner { grid-template-columns: 1fr; row-gap: 28px; }
    .hero__copy { text-align: center; }
    .lead { margin-inline: auto; }
    .hero__badges { justify-content: center; }
    .hero__art { width: 100%; max-width: 420px; transform: translateY(18px) scale(1.04); }
  }
  /* phones: the stat tiles (pulled up 64px) meet the bottom of the image with no gap */
  @media (max-width: 767px) { .hero { padding-bottom: 56px; } }
</style>