---
// ===== src/components/AboutPage.astro =====
// The whole About us page for one language; src/pages/about.astro (en) and src/pages/hi/about.astro (hi) just render this.
// The content comes from the admin "About page" screen (see lib/about.ts). Every block is optional: one with nothing
// in it is simply not rendered, so the admin decides exactly what shows.
// The contact form posts to /api/contact/ (src/pages/api/contact.ts), which hands the message to Admin > Messages.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import MobileAppShell from './MobileAppShell.astro';
import { useTranslations } from '../lib/i18n';
import { loadAbout } from '../lib/about';
import type { Locale } from '../i18n';

interface Props { lang: Locale; }
const locale: Locale = Astro.props.lang;
const t = useTranslations(locale);

const about = await loadAbout(locale);
const { hero, story, panels, features, benefits, timeline, highlight, contact, cta } = about;

const canonical = new URL(locale === 'hi' ? '/hi/about/' : '/about/', Astro.site).toString();
const pageTitle = about.seo.title || hero.title;
const pageDescription = about.seo.description || hero.subtitle.slice(0, 160);

// Light blocks alternate between a white and a warm tinted background, whichever of them the admin has filled in, so two
// neighbours never share one. The first is white (it sits under the curved white corner of the banner). The mission &
// values panels bring their own tints, so they stay on white; the orange benefits band restarts the sequence after it.
const tone: Record<string, string> = {};
let step = 0;
for (const key of ['story', 'panels', 'features', 'benefits', 'timeline', 'highlight', 'contact', 'cta'] as const) {
  if (!about[key]) continue;
  if (key === 'benefits') { step = 0; continue; }
  if (key === 'panels') { tone[key] = ''; step = 1; continue; }
  if (key === 'contact') { tone[key] = 'tint'; step = 0; continue; } // the dark card always sits on the cream background
  tone[key] = step % 2 ? 'tint' : '';
  step += 1;
}

// How many cards per row in the numbers band: 1 to 4 numbers sit in one row; 5 or 6 make two rows of three
const benefitCols = benefits ? (benefits.items.length <= 4 ? benefits.items.length : 3) : 4;
// Roughly how wide a number is, in em, glyph by glyph. The widest one in the band sets ONE font size that fits every card
// (the stylesheet divides the card's width by this), so a long number gets a smaller size instead of breaking or overflowing.
const emWidth = (s: string) => [...s].reduce((w, ch) => w + (/[0-9]/.test(ch) ? .62 : /[A-Z]/.test(ch) ? .68 : /[a-z]/.test(ch) ? .56 : /[ ,.]/.test(ch) ? .28 : ch === '/' ? .36 : .62), 0);
const benefitW = benefits ? Math.max(2.2, ...benefits.items.map((b) => emWidth(b.value))) : 3.4;

// Everything the contact form's script needs, in the visitor's language (passed as JSON, escaped for a <script> tag)
const form = t('aboutPage.form');
const formText = contact ? {
  sending: form.sending,
  success: contact.success || form.successDefault,
  errors: form.errors,
} : null;
const formJson = formText ? JSON.stringify(formText).replace(/</g, '\\u003c') : '';

// A pair of dice drawn as vector art (isometric cubes, pips as circles mapped onto each face): one white with deep-orange
// pips, one gold, so they stand out on the orange contact card. Used when the admin has not set a picture of their own.
type Pt = [number, number];
const PIPS: Record<number, Pt[]> = {
  1: [[.5, .5]], 2: [[.28, .28], [.72, .72]], 3: [[.25, .25], [.5, .5], [.75, .75]],
  4: [[.28, .28], [.72, .28], [.28, .72], [.72, .72]], 5: [[.28, .28], [.72, .28], [.5, .5], [.28, .72], [.72, .72]],
  6: [[.3, .25], [.7, .25], [.3, .5], [.7, .5], [.3, .75], [.7, .75]],
};
const HALF = 86.6;
const makeCube = (o: { transform: string; top: string; left: string; right: string; edge: string; pip: string; faces: [number, number, number] }) => {
  const defs: { fill: string; A: Pt; B: Pt; D: Pt; n: number }[] = [
    { fill: o.top, A: [-HALF, -50], B: [0, -100], D: [0, 0], n: o.faces[0] },
    { fill: o.left, A: [-HALF, -50], B: [0, 0], D: [-HALF, 50], n: o.faces[1] },
    { fill: o.right, A: [0, 0], B: [HALF, -50], D: [0, 100], n: o.faces[2] },
  ];
  return {
    transform: o.transform, edge: o.edge, pip: o.pip,
    faces: defs.map(({ fill, A, B, D, n }) => {
      const C: Pt = [B[0] + D[0] - A[0], B[1] + D[1] - A[1]];
      return {
        fill, pips: PIPS[n],
        points: [A, B, C, D].map((p) => p.join(',')).join(' '),
        matrix: `matrix(${B[0] - A[0]} ${B[1] - A[1]} ${D[0] - A[0]} ${D[1] - A[1]} ${A[0]} ${A[1]})`,
      };
    }),
  };
};
const cubes = [
  makeCube({ transform: 'translate(70 -34) rotate(10) scale(.85)', top: '#fef08a', left: '#facc15', right: '#ca8a04', edge: '#a16207', pip: '#7c2d12', faces: [4, 6, 3] }),
  makeCube({ transform: 'translate(-50 40) rotate(-8) scale(.95)', top: '#ffffff', left: '#fff1e0', right: '#fdba74', edge: '#c2410c', pip: '#c2410c', faces: [5, 3, 2] }),
];

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": canonical,
  "inLanguage": locale === 'hi' ? 'hi-IN' : 'en-IN',
};
---

<Base title={pageTitle} description={pageDescription} canonical={canonical} jsonLd={aboutJsonLd}>
  <div class="header-slot"><Header lang={locale} overlay /></div>
  <div class="mobile-only"><MobileAppShell title={t('aboutPage.shellTitle')} active="about" lang={locale} /></div>

  <div class="about-page">
    {/* ---------- Banner ---------- */}
    <section class="hero">
      <div class:list={['container', 'hero-inner', { 'has-art': !!hero.image }]}>
        <div class="hero-copy">
          {hero.eyebrow && <span class="eyebrow">{hero.eyebrow}</span>}
          <h1>{hero.title}</h1>
          {hero.subtitle && <p class="lead">{hero.subtitle}</p>}
          {(hero.primary || hero.secondary) && (
            <div class="actions">
              {hero.primary && (
                <a class="btn btn-primary" href={hero.primary.href}>
                  <span>{hero.primary.label}</span>
                  <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
                </a>
              )}
              {hero.secondary && <a class="btn btn-outline" href={hero.secondary.href}>{hero.secondary.label}</a>}
            </div>
          )}
        </div>
        {hero.image && (
          <div class="hero-art">
            <img src={hero.image.src} alt={hero.image.alt} loading="eager" decoding="async" />
          </div>
        )}
      </div>
    </section>

    {/* ---------- Who we are ---------- */}
    {story && (
      <section class:list={['block', tone.story]}>
        <div class="container">
          <div class:list={['story', { 'with-side': !!(story.quote || story.image) }]}>
            <div class="story-copy">
              {story.title && <h2>{story.title}</h2>}
              {story.html && <div class="rich" set:html={story.html} />}
            </div>
            {(story.quote || story.image) && (
              <div class="story-side">
                {story.image && (
                  <figure class="story-art"><img src={story.image.src} alt={story.image.alt} loading="lazy" decoding="async" /></figure>
                )}
                {story.quote && <blockquote class="story-quote"><p>{story.quote}</p></blockquote>}
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    {/* ---------- Mission & values ---------- */}
    {panels && (
      <section class:list={['block', tone.panels]}>
        <div class="container">
          <div class="panels">
            {panels.items.map((p, i) => (
              <article class:list={['panel', i % 2 ? 'warm' : 'cool']}>
                {p.icon && <span class="panel-badge" aria-hidden="true">{p.icon}</span>}
                <h3>{p.title}</h3>
                {p.html && <div class="rich" set:html={p.html} />}
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ---------- Cards ---------- */}
    {features && (
      <section class:list={['block', tone.features]}>
        <div class="container">
          {(features.title || features.intro) && (
            <header class="block-head">
              {features.title && <h2>{features.title}</h2>}
              {features.intro && <p class="intro">{features.intro}</p>}
            </header>
          )}
          <ul class="cards">
            {features.items.map((item) => (
              <li class="card">
                {item.icon && <span class="ico" aria-hidden="true">{item.icon}</span>}
                <h3>{item.title}</h3>
                {item.html && <div class="rich" set:html={item.html} />}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* ---------- Our benefits (brand-orange band with big numbers) ---------- */}
    {benefits && (
      <section class="benefits">
        <svg class="deco spark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 0c1 8 4 11 12 12-8 1-11 4-12 12-1-8-4-11-12-12 8-1 11-4 12-12Z" /></svg>
        <div class="container">
          {benefits.title && <h2>{benefits.title}</h2>}
          <ul class="benefit-grid" style={`--cols:${benefitCols}; --w:${benefitW.toFixed(2)}`}>
            {benefits.items.map((b) => (
              <li class="benefit">
                {b.icon && <span class="b-icon" aria-hidden="true">{b.icon}</span>}
                <span class="b-num">{b.value}</span>
                <span class="b-lbl">{b.label}</span>
              </li>
            ))}
          </ul>
        </div>
        <svg class="deco rings" viewBox="0 0 138 138" aria-hidden="true" focusable="false">
          {[0, 1, 2].flatMap((r) => [0, 1, 2].map((c) => <circle cx={23 + c * 46} cy={23 + r * 46} r="22" />))}
        </svg>
      </section>
    )}

    {/* ---------- Timeline ---------- */}
    {timeline && (
      <section class:list={['block', tone.timeline]}>
        <div class="container">
          {(timeline.title || timeline.intro) && (
            <header class="block-head">
              {timeline.title && <h2>{timeline.title}</h2>}
              {timeline.intro && <p class="intro">{timeline.intro}</p>}
            </header>
          )}
          <ol class="timeline">
            {timeline.items.map((step) => (
              <li>
                {step.label && <span class="when">{step.label}</span>}
                <h3>{step.title}</h3>
                {step.html && <div class="rich" set:html={step.html} />}
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {/* ---------- Info box ---------- */}
    {highlight && (
      <section class:list={['block', tone.highlight]}>
        <div class="container">
          <aside class="callout">
            {highlight.title && <h2>{highlight.title}</h2>}
            {highlight.html && <div class="rich" set:html={highlight.html} />}
          </aside>
        </div>
      </section>
    )}

    {/* ---------- Contact form: a large dark card, heading + form on the left, a picture (or a pair of dice) on the right ---------- */}
    {contact && (
      <section id="contact" class:list={['block', 'contact', tone.contact]}>
        <div class="container">
          <div class="contact-card">
            <svg class="contact-rings" viewBox="0 0 360 180" aria-hidden="true" focusable="false">
              {[0, 1, 2, 3].flatMap((r) => [0, 1, 2, 3, 4, 5, 6, 7].map((c) => <circle cx={22 + c * 45} cy={22 + r * 45} r="22" />))}
            </svg>

            <div class="contact-main">
              <div class="contact-copy">
                {contact.title && <h2>{contact.title}</h2>}
                {contact.intro && <p class="contact-intro">{contact.intro}</p>}
              </div>

              <form id="contact-form" novalidate>
                <div class="row">
                  <div class="field">
                    <input id="cf-name" name="name" type="text" placeholder=" " autocomplete="name" maxlength="100" required aria-describedby="cf-err-name" />
                    <label for="cf-name">{form.name}</label>
                    <span class="err" id="cf-err-name" role="alert"></span>
                  </div>
                  <div class="field">
                    <input id="cf-email" name="email" type="email" placeholder=" " autocomplete="email" maxlength="200" required aria-describedby="cf-err-email" />
                    <label for="cf-email">{form.email}</label>
                    <span class="err" id="cf-err-email" role="alert"></span>
                  </div>
                </div>
                <div class="row">
                  <div class="field">
                    <input id="cf-phone" name="phone" type="tel" placeholder=" " autocomplete="tel" maxlength="30" aria-describedby="cf-err-phone" />
                    <label for="cf-phone">{form.phone}</label>
                    <span class="err" id="cf-err-phone" role="alert"></span>
                  </div>
                  <div class="field">
                    <input id="cf-userid" name="userId" type="text" placeholder=" " autocomplete="off" maxlength="60" aria-describedby="cf-err-userId" />
                    <label for="cf-userid">{form.userId}</label>
                    <span class="err" id="cf-err-userId" role="alert"></span>
                  </div>
                </div>
                <div class="field">
                  <textarea id="cf-message" name="message" rows="3" placeholder=" " maxlength="2000" required aria-describedby="cf-err-message"></textarea>
                  <label for="cf-message">{form.message}</label>
                  <span class="err" id="cf-err-message" role="alert"></span>
                </div>

                {/* Honeypot: people never see or reach this field; scripts fill it in */}
                <div class="hp" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
                <input type="hidden" name="token" value="" />
                <input type="hidden" name="lang" value={locale} />

                <button type="submit" class="btn btn-primary send">
                  <svg class="plane" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 2 11 13" /><path d="M22 2 15 22l-4-9-9-4 20-7Z" /></svg>
                  <span class="send-label" data-label={contact.button || form.send}>{contact.button || form.send}</span>
                </button>
                <p class="form-status" role="status" aria-live="polite"></p>
                <noscript><p class="form-status show">{form.noscript}</p></noscript>
              </form>
              <div class="form-success" id="contact-success" role="status" tabindex="-1" hidden>
                <span class="tick" aria-hidden="true">✓</span>
                <p>{contact.success || form.successDefault}</p>
              </div>
              {contact.note && <p class="contact-note">{contact.note}</p>}
            </div>

            <div class="contact-art">
              {contact.image ? (
                <img src={contact.image.src} alt={contact.image.alt} loading="lazy" decoding="async" />
              ) : (
                <svg class="dice" viewBox="-150 -135 310 300" aria-hidden="true" focusable="false">
                  <ellipse class="dice-shadow" cx="-6" cy="138" rx="150" ry="15" />
                  {cubes.map((cube) => (
                    <g transform={cube.transform}>
                      {cube.faces.map((f) => (
                        <>
                          <polygon points={f.points} fill={f.fill} stroke={cube.edge} stroke-width="6" stroke-linejoin="round" />
                          <g transform={f.matrix} fill={cube.pip}>
                            {f.pips.map(([x, y]) => <circle cx={x} cy={y} r="0.085" />)}
                          </g>
                        </>
                      ))}
                    </g>
                  ))}
                </svg>
              )}
            </div>
          </div>
        </div>
        <script is:inline type="application/json" id="contact-i18n" set:html={formJson}></script>
      </section>
    )}

    {/* ---------- Bottom banner ---------- */}
    {cta && (
      <section class:list={['block', tone.cta]}>
        <div class="container">
          <div class="cta-card">
            {cta.title && <h2>{cta.title}</h2>}
            {cta.html && <div class="rich" set:html={cta.html} />}
            {cta.button && (
              <a class="btn btn-gold" href={cta.button.href}>
                <span>{cta.button.label}</span>
                <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
              </a>
            )}
          </div>
        </div>
      </section>
    )}
  </div>

  <Footer lang={locale} />
</Base>

<script>
  // Contact form: checks the fields, asks /api/contact/ for a signed token on load, sends the message as JSON and
  // shows the answer in the visitor's language. Nothing is sent without JavaScript (the form says so).
  const formEl = document.getElementById('contact-form');
  if (formEl instanceof HTMLFormElement) {
    const form: HTMLFormElement = formEl;
    const text = JSON.parse(document.getElementById('contact-i18n')?.textContent || '{}') as { sending: string; success: string; errors: Record<string, string> };
    const errors = text.errors || {};
    const status = form.querySelector('.form-status') as HTMLElement;
    const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const label = submit.querySelector('.send-label') as HTMLElement;
    const original = label.dataset.label || label.textContent || '';
    const tokenInput = form.elements.namedItem('token') as HTMLInputElement;
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;

    const EMAIL = /^[^\s@<>"'`]+@[^\s@<>"'`]+\.[^\s@<>"'`]{2,}$/;
    const PHONE = /^[0-9+()\-\s.]{6,30}$/;

    const loadToken = async () => {
      try {
        const res = await fetch('/api/contact/', { cache: 'no-store', headers: { Accept: 'application/json' } });
        const data = await res.json();
        tokenInput.value = typeof data.token === 'string' ? data.token : '';
      } catch { /* the submit will ask again */ }
    };
    loadToken();

    const setError = (name: string, message: string) => {
      const input = field(name);
      const out = document.getElementById(`cf-err-${name}`);
      if (out) out.textContent = message;
      if (input) input.setAttribute('aria-invalid', message ? 'true' : 'false');
    };
    const clearErrors = () => { for (const n of ['name', 'email', 'phone', 'userId', 'message']) setError(n, ''); showStatus(''); };
    const showStatus = (message: string) => { status.textContent = message; status.classList.toggle('show', !!message); };

    const validate = (): string | null => {
      const v = (n: string) => field(n).value.trim();
      let first: string | null = null;
      const bad = (n: string, m: string) => { setError(n, m); first = first || n; };
      if (!v('name')) bad('name', errors.name);
      if (!EMAIL.test(v('email'))) bad('email', errors.email);
      if (v('phone') && !PHONE.test(v('phone'))) bad('phone', errors.phone);
      if (v('userId').length > 60) bad('userId', errors.userId);
      const msg = v('message');
      if (msg.length < 10 || msg.length > 2000 || (msg.match(/https?:\/\/|www\./gi) || []).length > 2) bad('message', errors.message);
      return first;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();
      const firstBad = validate();
      if (firstBad) { field(firstBad).focus(); return; }

      submit.disabled = true;
      label.textContent = text.sending;
      try {
        if (!tokenInput.value) await loadToken();
        const body = {
          name: field('name').value, email: field('email').value, phone: field('phone').value, userId: field('userId').value,
          message: field('message').value, lang: field('lang').value, website: field('website').value, token: tokenInput.value,
        };
        const res = await fetch('/api/contact/', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) });
        const data = await res.json().catch(() => ({} as Record<string, unknown>));
        if (data.ok) {
          form.hidden = true;
          const done = document.getElementById('contact-success');
          if (done) { done.hidden = false; done.focus(); }
          return;
        }
        const code = typeof data.code === 'string' ? data.code : 'error';
        if (code === 'reload') await loadToken();
        if (code === 'invalid' && typeof data.field === 'string' && document.getElementById(`cf-err-${data.field}`)) {
          setError(data.field, errors[data.field] || errors.invalid);
          field(data.field).focus();
        } else {
          showStatus(errors[code] || errors.error);
        }
      } catch {
        showStatus(errors.error);
      } finally {
        if (!form.hidden) { submit.disabled = false; label.textContent = original; }
      }
    });
  }
</script>

<style>
  .desktop-only { display: block; }
  .mobile-only { display: none; }
  @media (max-width: 767px) {
    .desktop-only { display: none; }
    .mobile-only { display: block; }
  }

  .about-page { --bg: var(--surface); --navy: #111827; color: var(--text-primary); }

  /* ----- buttons: pills with an arrow, like the banner on the reference page ----- */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 13px 30px; border-radius: 999px; border: 0; font-family: inherit; font-weight: 800; font-size: 16px; letter-spacing: .04em; text-transform: uppercase; text-decoration: none; cursor: pointer; transition: transform .15s, box-shadow .15s, background-color .15s, border-color .15s; }
  .btn:hover { transform: translateY(-2px); }
  .btn:focus-visible { outline: 3px solid var(--navy); outline-offset: 3px; }
  .btn .chev { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; transition: transform .15s; }
  .btn:hover .chev { transform: translateX(3px); }
  .btn:disabled { opacity: .65; cursor: progress; transform: none; }
  .btn-primary { color: #431407; background: linear-gradient(180deg, #fff3a3 0%, var(--brand-gold) 48%, #f59e0b 100%); box-shadow: 0 14px 24px -12px rgba(154, 52, 18, .6), inset 0 1px 0 rgba(255,255,255,.85), inset 0 -2px 0 rgba(180, 83, 9, .22); }
  .btn-primary:hover { filter: brightness(1.04); box-shadow: 0 18px 28px -12px rgba(154, 52, 18, .7), inset 0 1px 0 rgba(255,255,255,.85), inset 0 -2px 0 rgba(180, 83, 9, .22); }
  .btn-outline { color: var(--navy); background: transparent; border: 2px solid rgba(12, 18, 48, .28); }
  .btn-outline:hover { border-color: var(--navy); background: rgba(12, 18, 48, .05); }
  .btn-gold { color: #0b0b0f; background: linear-gradient(135deg, var(--brand-gold), var(--brand-orange)); box-shadow: 0 10px 24px -8px rgba(249, 115, 22, .65); }
  .btn-gold:focus-visible { outline-color: #fff; }

  /* ----- banner: light cream, big bold title on the left, artwork on the right, white corner cut into the bottom ----- */
  .hero { --hero-pb: clamp(64px, 8vw, 104px); position: relative; overflow: hidden; color: #fff; padding-block: clamp(48px, 7vw, 96px) var(--hero-pb); background:
      radial-gradient(55% 70% at 88% 18%, rgba(255, 244, 190, .55), transparent 62%),
      radial-gradient(45% 55% at 6% 92%, rgba(255, 255, 255, .16), transparent 60%),
      linear-gradient(158deg, var(--brand-orange) 0%, #fb8c1d 42%, var(--brand-gold) 100%); }
  /* faint dotted texture, like the home hero */
  .hero::before { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .45; background-image: radial-gradient(rgba(255,255,255,.35) 1.2px, transparent 1.4px); background-size: 26px 26px; -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 75%); mask-image: linear-gradient(180deg, #000 0%, transparent 75%); }
  /* the header sits on top of the banner (desktop) / the phone top bar is a 61px spacer above it */
  @media (min-width: 768px) { .hero { padding-top: calc(clamp(48px, 7vw, 96px) + 64px); } }
