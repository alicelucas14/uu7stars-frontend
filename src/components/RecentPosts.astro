---
// ===== src/components/RecentPosts.astro =====

import { getBlogPosts } from '../services/api';
import type { BlogPostListItem } from '../services/api';
import type { Locale } from '../i18n';
import { createPath } from '../lib/paths';
import { useTranslations } from '../lib/i18n';

interface Props {
  excludeSlug?: string;
  limit?: number;
  lang?: Locale;
}
const { excludeSlug, limit = 4, lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const posts = await getBlogPosts(lang).catch(() => []);
const recent = posts.filter(p => p.slug !== excludeSlug).slice(0, limit);

const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;
const toAbsolute = (p?: string) => !p ? '' : (p.startsWith('http') ? p : new URL(p, API_BASE_URL).toString());
---
{recent.length > 0 && (
  <div class="sidebar-widget">
    <h3 class="widget-title">{t('sidebarWidgets.recentPosts')}</h3>
    <div class="post-list">
      {recent.map((post: BlogPostListItem) => (
        <a href={createPath(`/blog/${post.slug}/`, lang)} class="post-item">
          <img src={toAbsolute(post.image)} alt={`Thumbnail for ${post.title}`} width="80" height="50" loading="lazy" />
          <div class="post-info">
            <span class="post-title">{post.title}</span>
            <time datetime={post.publishedAt} class="post-date">
              {new Date(post.publishedAt).toLocaleDateString(lang === 'hi' ? 'hi-IN' : 'en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
            </time>
          </div>
        </a>
      ))}
    </div>
  </div>
)}
<style>
.sidebar-widget{position:relative;overflow:hidden;background:#fff;border:1px solid color-mix(in oklab,var(--brand-orange) 16%,#fff);border-radius:24px;padding:24px 20px 20px;box-shadow:0 24px 40px -32px rgba(124,45,18,.5)}
.sidebar-widget::before{content:"";position:absolute;left:0;right:0;top:0;height:4px;background:linear-gradient(90deg,var(--brand-orange),var(--brand-gold))}
.widget-title{margin:0 0 16px;padding:0 0 0 12px;border:0;border-left:4px solid var(--brand-orange);font-size:13px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;line-height:1.2;color:#c2410c}
.post-list{display:grid;gap:14px}
.post-item{display:grid;grid-template-columns:84px 1fr;gap:12px;align-items:center;text-decoration:none}
.post-item img{width:84px;height:56px;object-fit:cover;border-radius:12px;box-shadow:0 8px 14px -10px rgba(67,20,7,.6);transition:transform .25s ease}
.post-title{font-weight:750;color:var(--text-primary);line-height:1.35;font-size:14px;margin-bottom:4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.post-item:hover .post-title{color:#c2410c}
.post-item:hover img{transform:scale(1.05)}
.post-date{font-size:12px;color:var(--text-secondary)}
</style>
