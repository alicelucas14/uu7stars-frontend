---
// ===== src/components/ArticleHead.astro =====
// --- CORRECTED: Restored author link using the new robust slugify function ---
import type { Locale } from '../i18n';
import { useTranslations } from '../lib/i18n';
import { createPath, slugify } from '../lib/paths';

export interface Props {
  title: string;
  publishedAt: string;
  author: string;
  tags?: string[];
  lang?: Locale;
  asH1?: boolean;
}

const { title, publishedAt, author, tags = [], lang = 'en', asH1 = true } = Astro.props;
const t = useTranslations(lang);

const formattedDate = new Date(publishedAt).toLocaleDateString(lang === 'hi' ? 'hi-IN' : 'en-IN', {
  year: 'numeric', month: 'long', day: 'numeric'
});

// Names with no Latin characters slugify to "" - there is no archive page for them, so they are
// shown as plain text instead of linking to "/blog/author//" etc. (which 404s)
const authorSlug = slugify(author);
const authorUrl = authorSlug ? createPath(`/blog/author/${authorSlug}/`, lang) : '';

const category = tags.length > 0 ? tags[0] : null;
const categorySlug = category ? slugify(category) : '';
const otherTags = tags.slice(1).map((tag) => ({ tag, slug: slugify(tag) }));
---
<header class="article-head">
  <div class="meta">
    {category && (
      <>
        {categorySlug
          ? <a href={createPath(`/blog/category/${categorySlug}/`, lang)} class="category-pill">{category}</a>
          : <span class="category-pill">{category}</span>}
        <span aria-hidden="true">•</span>
      </>
    )}
    <time datetime={publishedAt}>{formattedDate}</time>
    <span aria-hidden="true">•</span>
    {/* The author is a link again, with correct i18n formatting and URL */}
    <span>
      {t('blogPost.byAuthor').replace('{authorName}', '')}
      {authorUrl ? <a href={authorUrl} rel="author">{author}</a> : author}
    </span>
  </div>

  {asH1 ? <h1 class="title">{title}</h1> : <div class="title h1-alt" role="heading" aria-level="1">{title}</div>}

  {otherTags.length > 0 && (
    <div class="tags" aria-label="Tags">
      {otherTags.map(({ tag, slug }) => (
        slug
          ? <a href={createPath(`/blog/tag/${slug}/`, lang)} class="tag">{tag}</a>
          : <span class="tag">{tag}</span>
      ))}
    </div>
  )}
</header>
<style>
.article-head{padding-block:28px 12px;text-align:left}
.meta{display:flex;justify-content:flex-start;align-items:center;flex-wrap:wrap;gap:8px 10px;font-size:13.5px;color:var(--text-secondary);margin-bottom:18px}
.meta > span[aria-hidden="true"]{display:none}
.meta time{display:inline-block;padding:5px 13px;border-radius:999px;font-weight:700;color:#9a3412;background:color-mix(in oklab,var(--brand-orange) 10%,#fff);border:1px solid color-mix(in oklab,var(--brand-orange) 24%,#fff)}
.meta > span:not([aria-hidden]){display:inline-block;padding:5px 13px;border-radius:999px;background:#fff;border:1px solid color-mix(in oklab,var(--brand-orange) 20%,#fff);color:var(--text-secondary)}
.meta a{color:#c2410c;text-decoration:none;font-weight:700}.meta a:hover{text-decoration:underline}
.category-pill{display:inline-block;padding:6px 14px;border-radius:999px;font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;line-height:1.2;color:#fff!important;text-decoration:none!important;background:linear-gradient(135deg,#fb923c,var(--brand-orange) 55%,#ea580c);border:0;box-shadow:0 10px 16px -10px rgba(234,88,12,.8),inset 0 1px 0 rgba(255,255,255,.4)}
.category-pill:hover{filter:brightness(1.05);text-decoration:none!important}
.title{margin:0 0 22px;font-size:clamp(30px,4.4vw,46px);line-height:1.12;letter-spacing:-.025em;color:var(--text-primary)}
.title::after{content:"";display:block;width:52px;height:4px;margin-top:18px;border-radius:4px;background:linear-gradient(90deg,var(--brand-orange),var(--brand-gold))}
.tags{display:flex;flex-wrap:wrap;justify-content:flex-start;gap:8px}
.tag{display:inline-block;padding:5px 12px;border-radius:999px;background:#fff;border:1px solid color-mix(in oklab,var(--brand-orange) 24%,#fff);color:var(--text-secondary);font-size:13px;font-weight:600;line-height:1.2;text-decoration:none;transition:background-color .2s ease,color .2s ease,border-color .2s ease}
.tag::before{content:"#";margin-right:2px;color:var(--brand-orange);font-weight:800}
.tag:hover{color:#c2410c;background:color-mix(in oklab,var(--brand-orange) 10%,#fff);border-color:color-mix(in oklab,var(--brand-orange) 50%,#fff)}
</style>
