---
// ===== src/components/Footer.astro =====
// --- REFACTOR: All links are now language-aware using the createPath utility ---

import BadgeIcon from './BadgeIcon.astro';
import { getSettings } from '../services/api';
import type { Locale } from '../i18n';
import { useTranslations } from '../lib/i18n';
import { createPath } from '../lib/paths'; // <-- IMPORT the new utility
import { resolveExtraSocialLinks, isFixedSocialShown } from '../lib/socialPlatforms';
import { getMenuPages } from '../lib/menuPages';

interface Props {
  lang?: Locale;
}
const { lang = 'en' } = Astro.props as Props;
const t = useTranslations(lang);

const settings = await getSettings();
const year = new Date().getFullYear();

// --- UPDATED: home link is now language-aware ---
const brandInfo = {
  name: settings?.siteName || "Starsuu7",
  tagline: t('footer.tagline'),
  homeUrl: createPath('/', lang)
};

// `display` = key in settings.socialLinkDisplay (admin: Footer / Sidebar / Schedule per link)
const potentialSocials = [
  { key: 'youtubeUrl', display: 'youtube', imgSrc: "/wordpress/youtube.png", label: 'YouTube' },
  { key: 'facebookUrl', display: 'facebook', imgSrc: "/wordpress/facebook.png", label: 'Facebook' },
  { key: 'instagramUrl', display: 'instagram', imgSrc: "/wordpress/instagram.webp", label: 'Instagram' },
  { key: 'telegramUrl', display: 'telegram', imgSrc: "/wordpress/telegram.png", label: 'Telegram' },
  { key: 'whatsappUrl', display: 'whatsapp', imgSrc: "/wordpress/whatsapp.png", label: 'WhatsApp' },
  { key: 'twitterUrl', display: 'twitter', imgSrc: "/wordpress/x.webp", label: 'Twitter' },
];

const now = Date.now();
const socialLinks = settings
  ? [
      ...potentialSocials
        .filter(s => isFixedSocialShown(settings.socialLinkDisplay, s.display, 'footer', now))
        .map(s => ({ ...s, href: settings[s.key as keyof typeof settings] as string }))
        .filter(s => s.href),
      // Extra links added in admin Settings -> "More Social Links"
      ...resolveExtraSocialLinks(settings.extraSocialLinks, 'footer', now),
    ]
  : [];

// --- UPDATED: All hrefs are now built dynamically using createPath ---
const navLinks = [
  { href: createPath("/", lang), label: t('footer.nav.home') },
  { href: createPath("/#games", lang), label: t('footer.nav.games') },
  { href: createPath("/faq/", lang), label: t('footer.nav.faq') },
  { href: createPath("/about/", lang), label: t('footer.nav.about') },
  { href: createPath("/download/", lang), label: t('mobileAppShell.download') },
  // Custom pages ticked "Show in the website menu" in the admin
  ...(await getMenuPages(lang)),
];

const legalLinks = [
  { href: createPath("/privacy-policy/", lang), label: t('footer.legalNav.privacy') },
  { href: createPath("/terms-of-service/", lang), label: t('footer.legalNav.terms') },
  { href: createPath("/responsible-gaming/", lang), label: t('footer.legalNav.responsible') }
];
// --- END UPDATE ---

const integrityBadges = [
  { icon: 'no-bot', text: t('footer.integrityBadges.noBot') },
  { icon: 'iso', text: t('footer.integrityBadges.iso') },
  { icon: 'withdrawal', text: t('footer.integrityBadges.withdrawal') },
  { icon: 'rng', text: t('footer.integrityBadges.rng') },
];

const paymentPartners = [
  { imgSrc: "/wordpress/payment-1.webp", alt: "Paytm" },
  { imgSrc: "/wordpress/payment5-2.webp", alt: "RuPay" },
  { imgSrc: "/wordpress/payment7.webp", alt: "PhonePe" },
  { imgSrc: "/wordpress/payment6-2.webp", alt: "UPI" },
  { imgSrc: "/wordpress/payment2-2.webp", alt: "Visa" },
  { imgSrc: "/wordpress/payment4-2.webp", alt: "Mastercard" },
];
---

<footer class="site-footer clear-social-bar" role="contentinfo">
  <div class="container footer-inner">

    <section class="brand-card">
      {/* UPDATED: Language-aware home link */}
      <a href={brandInfo.homeUrl} class="brand" aria-label={`${brandInfo.name} — Home`}>
        <img src= "/logo.webp" width="44" height="44" alt={`${brandInfo.name} logo`} decoding="async" loading="lazy" />
        <div class="brand-names">
          <strong class="brand-name">{brandInfo.name}</strong>
          <span class="brand-tag">{brandInfo.tagline}</span>
        </div>
      </a>
      {socialLinks.length > 0 && (
        <div class="socials" aria-label="Follow us">
          {socialLinks.map(s => (
            <a class="social" href={s.href} aria-label={s.label} title={s.label} target="_blank" rel="noopener noreferrer">
              <img src={s.imgSrc} alt={s.label} width="20" height="20" decoding="async" loading="lazy" />
            </a>
          ))}
        </div>
      )}
    </section>

    <section class="sections" aria-label="Footer navigation">
      <details class="sec" open>
        <summary class="sec-head">{t('footer.quicklinks')}</summary>
        <nav class="sec-body list-grid" aria-label="Quicklinks">
          {navLinks.map(l => <a class="link" href={l.href}>{l.label}</a>)}
        </nav>
      </details>
      <details class="sec" open>
        <summary class="sec-head">{t('footer.legal')}</summary>
        <nav class="sec-body list-grid" aria-label="Legal">
          {legalLinks.map(l => <a class="link" href={l.href}>{l.label}</a>)}
        </nav>
      </details>
      <details class="sec" open>
        <summary class="sec-head">{t('footer.integrity')}</summary>
        <div class="sec-body badges" role="list">
          {integrityBadges.map(b => (
            <div class="badge" role="listitem">
              <BadgeIcon icon={b.icon} />
              <span>{b.text}</span>
            </div>
          ))}
        </div>
      </details>
    </section>

    <section class="partners" aria-label="Withdrawal & payment partners">
      <h3 class="partners-title">{t('footer.partners')}</h3>
      <div class="rail" role="list">
        {paymentPartners.map(p => (
          <div class="chip" role="listitem">
            <img src={p.imgSrc} alt={p.alt} decoding="async" loading="lazy" />
          </div>
        ))}
      </div>
    </section>

    <section class="legal-callouts" aria-label="Responsible gaming and regional availability">
      <p set:html={t('footer.disclaimer')} />
      <p set:html={t('footer.responsible')} />
    </section>
  </div>

  <div class="subbar">
    <div class="container subbar-inner">
      <p>© {year} {brandInfo.name}. {t('footer.copyright')}</p>
      <a class="to-top" href="#top" aria-label="Back to top">↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    color: #fff;
    background:
      radial-gradient(60% 50% at 100% 0%, rgba(250, 204, 21, .22), transparent 60%),
      linear-gradient(180deg, #f26a10 0%, #d9520a 45%, #b43f08 100%);
    border-radius: 36px 36px 0 0;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.3);
  }
  .footer-inner { display: grid; gap: 16px; padding-block: 32px 24px; }

  /* brand + social */
  .brand-card { display: grid; gap: 16px; padding: 18px; border-radius: 24px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.24); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .brand { display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: center; text-decoration: none; color: inherit; }
  .brand img { display: block; width: 52px; height: 52px; object-fit: contain; filter: drop-shadow(0 4px 8px rgba(67, 20, 7, .3)); }
  .brand-name { display: block; font-size: 20px; letter-spacing: -.01em; }
  .brand-tag { display: block; max-width: 40ch; font-size: 13px; line-height: 1.5; color: rgba(255,255,255,.88); }
  .socials { display: flex; flex-wrap: wrap; gap: 10px; }
  .social { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.35); transition: transform .2s ease, background-color .2s ease; }
  .social:hover { transform: translateY(-3px); background: rgba(255,255,255,.95); }
  .social img { width: 20px; height: 20px; object-fit: contain; }

  /* link groups (collapsible cards on phones) */
  .sections { display: grid; gap: 12px; }
  .sec { overflow: clip; border-radius: 22px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.24); }
  .sec-head {
    list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; margin: 0; padding: 15px 18px;
    font-size: 13px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: #fde68a; -webkit-tap-highlight-color: transparent;
  }
  .sec-head::-webkit-details-marker { display: none; }
  .sec-head::after { content: ""; width: 9px; height: 9px; border-right: 2.5px solid currentColor; border-bottom: 2.5px solid currentColor; transform: rotate(45deg); margin-top: -4px; transition: transform .25s ease; }
  .sec[open] .sec-head::after { transform: rotate(225deg); margin-top: 4px; }
  .sec-body { padding: 2px 14px 16px; }
  .list-grid { display: grid; gap: 8px; grid-template-columns: repeat(2, 1fr); }
  .link { display: block; padding: 11px 14px; border-radius: 14px; font-size: 14px; font-weight: 700; color: #fff; text-decoration: none; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22); transition: background-color .2s ease, color .2s ease; }
  .link:hover { background: #fff; color: #c2410c; }
  .badges { display: grid; gap: 8px; grid-template-columns: repeat(2, 1fr); }
  .badge { display: flex; align-items: center; gap: 9px; padding: 11px 12px; border-radius: 14px; font-size: 12.5px; font-weight: 700; line-height: 1.25; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22); }
  .badge :global(.icon-wrapper) { color: #fef08a; }
  .badge :global(svg) { width: 20px; height: 20px; flex: none; }

  /* payment partners */
  .partners { padding: 16px 18px 18px; border-radius: 22px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.24); }
  .partners-title { margin: 0 0 12px; font-size: 13px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: #fde68a; }
  .rail { display: grid; grid-auto-flow: column; grid-auto-columns: max-content; gap: 10px; overflow-x: auto; scrollbar-width: none; }
  .rail::-webkit-scrollbar { display: none; }
  .chip { display: grid; place-items: center; min-width: 76px; height: 42px; padding: 6px 12px; border-radius: 14px; background: #fff; box-shadow: 0 8px 14px -10px rgba(67, 20, 7, .7); }
  .chip img { max-height: 22px; max-width: 86px; object-fit: contain; }

  /* disclaimer */
  .legal-callouts { padding: 16px 18px; border-radius: 20px; font-size: 13px; line-height: 1.7; background: rgba(67, 20, 7, .22); border: 1px dashed rgba(255,255,255,.4); }
  .legal-callouts p { margin: 0 0 8px; color: #fff; }
  .legal-callouts p:last-child { margin: 0; }
  .legal-callouts :global(strong) { font-weight: 800; text-decoration: underline 0.08em rgba(255,255,255,.4); text-underline-offset: 2px; }

  /* bottom bar */
  .subbar { background: rgba(67, 20, 7, .28); border-top: 1px solid rgba(255,255,255,.2); padding-bottom: max(10px, env(safe-area-inset-bottom)); }
  .subbar-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-block: 14px; }
  .subbar p { margin: 0; font-size: 12.5px; color: rgba(255,255,255,.9); }
  .to-top { display: inline-grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; text-decoration: none; font-weight: 800; font-size: 17px; color: #431407; background: linear-gradient(180deg, #fff3a3, var(--brand-gold) 55%, #f59e0b); box-shadow: 0 8px 16px -8px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.8); transition: transform .2s ease; }
  .to-top:hover { transform: translateY(-3px); }

  /* desktop: brand | quicklinks | legal | integrity, then partners and the disclaimer across the page */
  @media (min-width: 900px) {
    .footer-inner { grid-template-columns: 1.5fr 1fr 1fr 1.2fr; grid-template-areas: "brand quicklinks legal integrity" "partners partners partners partners" "disclaimer disclaimer disclaimer disclaimer"; gap: 36px 28px; align-items: start; padding-block: 52px 32px; }
    .brand-card { grid-area: brand; }
    .sections { display: contents; }
    .sections > .sec:nth-of-type(1) { grid-area: quicklinks; }
    .sections > .sec:nth-of-type(2) { grid-area: legal; }
    .sections > .sec:nth-of-type(3) { grid-area: integrity; }
    .partners { grid-area: partners; }
    .legal-callouts { grid-area: disclaimer; }
    .sec { background: none; border: none; border-radius: 0; overflow: visible; }
    .sec-head { cursor: default; pointer-events: none; padding: 0 0 18px; font-size: 13px; }
    .sec-head::after { display: none; }
    .sec-body { display: grid; padding: 0; }
    .list-grid, .badges { grid-template-columns: 1fr; gap: 6px; }
    .link, .badge { padding: 6px 0; border: none; border-radius: 0; background: none; font-size: 15px; font-weight: 600; }
    .link { display: inline-block; justify-self: start; color: rgba(255,255,255,.92); transition: color .2s ease, transform .2s ease; }
    .link:hover { background: none; color: #fef08a; transform: translateX(4px); }
    .badge { gap: 12px; font-size: 14.5px; }
  }

  /* phones: keep the copyright line clear of the floating bottom navigation */
  @media (max-width: 767px) { .site-footer { padding-bottom: calc(80px + env(safe-area-inset-bottom)); border-radius: 28px 28px 0 0; } }
  @media print { .site-footer { background: #fff; color: #000; } }
  @media (prefers-reduced-motion: reduce) { .social, .link, .to-top, .sec-head::after { transition: none; } }
</style>
