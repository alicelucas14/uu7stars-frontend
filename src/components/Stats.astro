---
// ===== src/components/Stats.astro =====
// --- REFACTORED: Now uses the centralized 'useTranslations' utility ---
import type { Locale } from '../i18n';
import { useTranslations } from '../lib/i18n';

interface Props {
  lang?: Locale;
}
const { lang = 'en' } = Astro.props as Props;
const t = useTranslations(lang);
---
<section class="stats-section" aria-label="Starsuu7 in numbers">
  <div class="container">
    <div class="stats-card">
      <div class="stat">
        <span class="stat__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4z"/><path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"/></svg>
        </span>
        <span class="stat__num">150K+</span>
        <span class="stat__label">{t('stats.winners')}</span>
      </div>
      <div class="stat">
        <span class="stat__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3 20a6 6 0 0 1 12 0"/><circle cx="17" cy="9" r="2.4"/><path d="M16.5 14.2A5 5 0 0 1 21 19"/></svg>
        </span>
        <span class="stat__num">75M+</span>
        <span class="stat__label">{t('stats.players')}</span>
      </div>
      <div class="stat">
        <span class="stat__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9 8h6M9 11h6M9.5 8c3.5 0 3.5 5 0 5H9l4 3.5"/></svg>
        </span>
        <span class="stat__num">₹5 Cr+</span>
        <span class="stat__label">{t('stats.winnings')}</span>
      </div>
      <div class="stat">
        <span class="stat__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/></svg>
        </span>
        <span class="stat__num">24/7</span>
        <span class="stat__label">{t('stats.support')}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .stats-section { position: relative; z-index: 10; margin-top: -100px; margin-bottom: 56px; }

  /* Four separate brand-orange tiles: number bottom-left, small icon chip top-right, gold accent bar. */
  .stats-card { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }

  .stat {
    position: relative; overflow: hidden;
    display: grid; align-content: end; justify-items: start; gap: 2px;
    min-height: 140px; padding: 22px 22px 20px; text-align: left;
    border-radius: 22px;
    background:
      radial-gradient(90% 90% at 100% 0%, rgba(250, 204, 21, .28), transparent 62%),
      linear-gradient(150deg, #f26a10 0%, #d9520a 100%);
    border: 1px solid rgba(253, 224, 71, .4);
    box-shadow: 0 22px 40px -20px rgba(124, 45, 18, .7), inset 0 1px 0 rgba(255, 255, 255, .28);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  /* lift on hover only for a real mouse on wide screens; touch screens keep the tiles flat */
  @media (hover: hover) and (min-width: 768px) {
    .stat:hover { transform: translateY(-5px); box-shadow: 0 30px 46px -20px rgba(124, 45, 18, .75), inset 0 1px 0 rgba(255, 255, 255, .35); }
  }
  /* gold accent bar */
  .stat::before { content: ""; position: absolute; left: 22px; top: 0; width: 34px; height: 4px; border-radius: 0 0 4px 4px; background: linear-gradient(90deg, #fef08a, var(--brand-gold)); }

  .stat__icon {
    position: absolute; top: 18px; right: 18px;
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px;
    color: #fef08a; background: rgba(255, 255, 255, .16); border: 1px solid rgba(255, 255, 255, .28);
  }
  .stat__icon svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  .stat__num { display: block; font-size: clamp(30px, 3.2vw, 44px); font-weight: 800; line-height: 1.05; letter-spacing: -.025em; color: #fff; text-shadow: 0 2px 12px rgba(67, 20, 7, .3); }
  .stat__label { font-size: 12.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #fde68a; }

  @media (max-width: 980px) { .stats-section { margin-top: -90px; } .stats-card { gap: 12px; } .stat { padding: 20px 16px 16px; min-height: 124px; } .stat::before { left: 16px; } }

  /* phones: one swipeable row of tiles (about 2.7 visible, so it reads as scrollable) */
  @media (max-width: 767px) {
    .stats-section { margin-top: 0; margin-bottom: 36px; }
    .stats-card {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: minmax(124px, 1fr); gap: 10px;
      /* bleed to both screen edges so tiles scroll right off the screen; padding keeps the first and last tile on the page margin */
      margin-inline: calc(50% - 50vw); padding-inline: calc(50vw - 50%);
      overflow-x: auto; overflow-y: hidden; padding-block: 6px; margin-bottom: 0;
      scroll-snap-type: x proximity; scroll-padding-inline: 16px;
      -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain;
      -ms-overflow-style: none; scrollbar-width: none;
    }
    .stats-card::-webkit-scrollbar { display: none; }
    .stat { scroll-snap-align: start; min-height: 88px; padding: 14px 12px 12px; border-radius: 16px; box-shadow: inset 0 1px 0 rgba(255, 255, 255, .28); }
    .stat, .stat:hover, .stat:active, .stat:focus, .stat:focus-within { transform: none; box-shadow: inset 0 1px 0 rgba(255, 255, 255, .28); -webkit-tap-highlight-color: transparent; }
    .stat::before { left: 12px; width: 28px; height: 3px; }
    .stat__icon { top: 10px; right: 10px; width: 28px; height: 28px; border-radius: 9px; }
    .stat__icon svg { width: 15px; height: 15px; }
    .stat__num { font-size: 23px; }
    .stat__label { font-size: 10.5px; letter-spacing: .08em; }
  }

  @media (prefers-reduced-motion: reduce) { .stat { transition: none; } .stat:hover { transform: none; } }
</style>
