---
// ===== src/components/Stats.astro =====
// --- REFACTORED: Now uses the centralized 'useTranslations' utility ---
import type { Locale } from '../i18n';
import { useTranslations } from '../lib/i18n';

interface Props {
  lang?: Locale;
}
const { lang = 'en' } = Astro.props as Props;
const t = useTranslations(lang);
---
<section class="stats-section" aria-label="Starsuu7 in numbers">
  <div class="container">
    <div class="stats-card">
      <div class="stat">
        <span class="stat__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4z"/><path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"/></svg>
        </span>
        <span class="stat__num">150K+</span>
        <span class="stat__label">{t('stats.winners')}</span>
      </div>
      <div class="stat">
        <span class="stat__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3 20a6 6 0 0 1 12 0"/><circle cx="17" cy="9" r="2.4"/><path d="M16.5 14.2A5 5 0 0 1 21 19"/></svg>
        </span>
        <span class="stat__num">75M+</span>
        <span class="stat__label">{t('stats.players')}</span>
      </div>
      <div class="stat">
        <span class="stat__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9 8h6M9 11h6M9.5 8c3.5 0 3.5 5 0 5H9l4 3.5"/></svg>
        </span>
        <span class="stat__num">₹5 Cr+</span>
        <span class="stat__label">{t('stats.winnings')}</span>
      </div>
      <div class="stat">
        <span class="stat__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/></svg>
        </span>
        <span class="stat__num">24/7</span>
        <span class="stat__label">{t('stats.support')}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .stats-section { position: relative; z-index: 10; margin-top: -100px; margin-bottom: 56px; }

  .stats-card {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(255,255,255,.92));
    border: 1px solid rgba(255,255,255,.8);
    border-radius: 24px;
    box-shadow: 0 32px 60px -24px rgba(124, 45, 18, .5), 0 2px 0 rgba(255,255,255,.6) inset;
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    overflow: hidden;
  }

  .stat {
    position: relative;
    display: grid; justify-items: center; align-content: center; gap: 4px;
    padding: 24px 12px 22px; text-align: center;
    transition: background-color .25s ease;
  }
  .stat:hover { background: color-mix(in oklab, var(--brand-orange) 5%, transparent); }
  .stat + .stat::before {
    content: ""; position: absolute; left: 0; top: 22%; bottom: 22%; width: 1px;
    background: linear-gradient(180deg, transparent, color-mix(in oklab, var(--brand-orange) 28%, transparent), transparent);
  }

  .stat__icon {
    display: grid; place-items: center; width: 40px; height: 40px; margin-bottom: 6px; border-radius: 14px;
    color: #fff;
    background: linear-gradient(135deg, var(--brand-orange), #fbbf24);
    box-shadow: 0 8px 16px -6px rgba(249, 115, 22, .6), inset 0 1px 0 rgba(255,255,255,.45);
  }
  .stat__icon svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  .stat__num {
    display: block; font-size: clamp(26px, 3vw, 38px); font-weight: 800; line-height: 1.1; letter-spacing: -.02em;
    background: linear-gradient(135deg, #ea580c, #f59e0b);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .stat__label { font-size: 12.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--text-secondary, #6b7280); }

  @media (max-width: 980px) { .stats-section { margin-top: -90px; } }

  @media (max-width: 767px) {
    .stats-section { margin-top: -64px; margin-bottom: 40px; }
    .stats-card { grid-template-columns: repeat(2, 1fr); border-radius: 20px; }
    .stat { padding: 18px 10px 16px; }
    .stat + .stat::before { display: none; }
    .stat:nth-child(even)::before { display: block; top: 18%; bottom: 18%; }
    .stat:nth-child(n+3) { border-top: 1px solid color-mix(in oklab, var(--brand-orange) 14%, transparent); }
    .stat__icon { width: 36px; height: 36px; border-radius: 12px; }
  }

  @media (prefers-reduced-motion: reduce) { .stat { transition: none; } }
</style>
