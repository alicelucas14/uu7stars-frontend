---
// ===== src/components/SocialSidebar.astro =====
// Fixed left-edge bar linking to the site's social profiles. URLs come from the CMS Settings doc
// (same keys the Footer uses), so editing them in the admin panel updates this bar too.
// Desktop: always visible. Mobile: collapsed behind a small tab so it never covers page text.

import { getSettings } from '../services/api';
import { resolveExtraSocialLinks, isFixedSocialShown } from '../lib/socialPlatforms';

const settings = await getSettings();

// `display` = key in settings.socialLinkDisplay (admin: Footer / Sidebar / Schedule per link).
// X is off here unless the admin ticks "Sidebar" for it.
const networks = [
  { key: 'youtubeUrl', display: 'youtube', imgSrc: '/wordpress/social/youtube-64.webp', label: 'YouTube' },
  { key: 'facebookUrl', display: 'facebook', imgSrc: '/wordpress/social/facebook-64.webp', label: 'Facebook' },
  { key: 'instagramUrl', display: 'instagram', imgSrc: '/wordpress/social/instagram-64.webp', label: 'Instagram' },
  { key: 'telegramUrl', display: 'telegram', imgSrc: '/wordpress/social/telegram-64.webp', label: 'Telegram' },
  { key: 'whatsappUrl', display: 'whatsapp', imgSrc: '/wordpress/social/whatsapp-64.webp', label: 'WhatsApp' },
  { key: 'twitterUrl', display: 'twitter', imgSrc: '/wordpress/x.webp', label: 'X' },
];

// Only real web links: an empty value or a non-http(s) scheme (e.g. javascript:) is skipped.
// Extra links from admin Settings -> "More Social Links" follow the fixed ones.
const now = Date.now();
const links = settings
  ? [
      ...networks
        .filter((n) => isFixedSocialShown(settings.socialLinkDisplay, n.display, 'sidebar', now))
        .map((n) => ({ ...n, href: String(settings[n.key as keyof typeof settings] ?? '').trim() }))
        .filter((n) => /^https?:\/\//i.test(n.href)),
      ...resolveExtraSocialLinks(settings.extraSocialLinks, 'sidebar', now),
    ]
  : [];
---

{links.length > 0 && (
  <aside class="social-sidebar" aria-label="Follow us on social media" data-open="false">
    <ul class="ss-list" id="ss-list">
      {links.map((s) => (
        <li>
          <a
            class="ss-link"
            href={s.href}
            aria-label={`Follow us on ${s.label}`}
            data-label={s.label}
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src={s.imgSrc} alt="" width="30" height="30" decoding="async" />
          </a>
        </li>
      ))}
    </ul>
    <button class="ss-toggle" type="button" aria-expanded="false" aria-controls="ss-list" aria-label="Show social links">
      <svg class="ico-share" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
        <path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4" />
      </svg>
      <svg class="ico-close" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </aside>
)}

<style>
  .social-sidebar {
    position: fixed;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    z-index: 1000;
    display: flex;
    align-items: stretch;
  }

  /* Slim frosted dock hugging the left edge; icons sit bare on it and lift on hover, with a label tooltip. */
  .ss-list {
    list-style: none;
    margin: 0;
    padding: 8px 6px;
    display: grid;
    gap: 4px;
    background: rgba(255, 255, 255, .82);
    -webkit-backdrop-filter: blur(14px) saturate(1.4); backdrop-filter: blur(14px) saturate(1.4);
    border: 1px solid rgba(255, 255, 255, .7);
    border-left: none;
    border-radius: 0 22px 22px 0;
    box-shadow: 0 18px 40px -14px rgba(124, 45, 18, .5), 0 2px 8px rgba(0, 0, 0, .08);
    /* Many links: scroll inside the bar instead of running off the screen */
    max-height: calc(100vh - 32px);
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    scrollbar-width: none;
  }
  .ss-list::-webkit-scrollbar { display: none; }
  .ss-list li { position: relative; }

  .ss-link {
    position: relative;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: transparent;
    border: 0;
    transition: transform .18s ease, background-color .18s ease, box-shadow .18s ease;
  }
  .ss-link img {
    width: 30px;
    height: 30px;
    object-fit: contain;
    display: block;
    transition: transform .18s ease;
  }
  .ss-link:hover, .ss-link:focus-visible {
    background: #fff;
    box-shadow: 0 8px 18px -8px rgba(124, 45, 18, .55), 0 0 0 1px rgba(249, 115, 22, .18);
    transform: translateX(3px);
  }
  .ss-link:hover img { transform: scale(1.1); }
  /* tooltip */
  .ss-link::after {
    content: attr(data-label);
    position: absolute; left: calc(100% + 10px); top: 50%; transform: translate(-4px, -50%);
    padding: 5px 10px; border-radius: 8px; white-space: nowrap; pointer-events: none;
    font-size: 12px; font-weight: 700; color: #fff; background: #111827;
    opacity: 0; transition: opacity .15s ease, transform .15s ease;
  }
  .ss-link:hover::after, .ss-link:focus-visible::after { opacity: 1; transform: translate(0, -50%); }
  .ss-link:focus-visible,
  .ss-toggle:focus-visible {
    outline: 2px solid var(--brand-orange, #f97316);
    outline-offset: 2px;
  }

  /* Phones only: a small tab on the left edge slides a frosted dock in; a round close button sits beside it. */
  .ss-toggle { display: none; }
  .ss-toggle svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .ss-toggle .ico-close { display: none; }

  @media (max-width: 767px) {
    /* children are positioned against the screen, not this wrapper */
    .social-sidebar { position: static; transform: none; display: block; }

    .ss-toggle {
      appearance: none; position: fixed; left: 0; top: 50%; z-index: 1002;
      display: inline-grid; place-items: center; width: 40px; height: 54px; padding: 0; cursor: pointer;
      color: #fff; background: linear-gradient(180deg, #fb923c, var(--brand-orange, #f97316));
      border: 1px solid rgba(255, 255, 255, .55); border-left: none; border-radius: 0 18px 18px 0;
      box-shadow: 0 12px 22px -8px rgba(124, 45, 18, .6), inset 0 1px 0 rgba(255, 255, 255, .35);
      transform: translateY(-50%);
      transition: left .3s cubic-bezier(.22, 1, .36, 1), width .3s ease, height .3s ease, border-radius .3s ease, background .2s ease, color .2s ease;
      -webkit-tap-highlight-color: transparent;
    }
    .social-sidebar[data-open='true'] .ss-toggle {
      left: 70px; top: 50%; width: 42px; height: 42px; border-radius: 50%; border-left: 1px solid rgba(255, 255, 255, .7);
      color: var(--brand-orange, #f97316); background: #fff;
      box-shadow: 0 10px 22px -8px rgba(124, 45, 18, .55);
    }
    .social-sidebar[data-open='true'] .ss-toggle .ico-share { display: none; }
    .social-sidebar[data-open='true'] .ss-toggle .ico-close { display: block; }

    .ss-list {
      position: fixed; left: 0; top: 50%; z-index: 1001; display: grid;
      padding: 8px 6px; gap: 6px; border-radius: 0 22px 22px 0;
      max-height: calc(100dvh - 190px); overflow-y: auto; overscroll-behavior: contain;
      transform: translate(-115%, -50%); opacity: 0; visibility: hidden; pointer-events: none;
      transition: transform .3s cubic-bezier(.22, 1, .36, 1), opacity .2s ease, visibility 0s linear .3s;
    }
    .social-sidebar[data-open='true'] .ss-list {
      transform: translate(0, -50%); opacity: 1; visibility: visible; pointer-events: auto;
      transition: transform .3s cubic-bezier(.22, 1, .36, 1), opacity .2s ease, visibility 0s;
    }
    .ss-link { width: 48px; height: 48px; }
    .ss-link img { width: 30px; height: 30px; }
    .ss-link::after { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ss-link, .ss-link img, .ss-link::after, .ss-toggle, .ss-list { transition: none !important; }
    .ss-link:hover, .ss-link:focus-visible { transform: none; }
    .ss-link:hover img { transform: none; }
  }

  @media print {
    .social-sidebar { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var bar = document.querySelector('.social-sidebar');
    if (!bar) return;
    var toggle = bar.querySelector('.ss-toggle');
    if (!toggle) return;
    function setOpen(open) {
      bar.setAttribute('data-open', open ? 'true' : 'false');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Hide social links' : 'Show social links');
    }
    toggle.addEventListener('click', function () {
      setOpen(bar.getAttribute('data-open') !== 'true');
    });
    document.addEventListener('click', function (e) {
      if (bar.getAttribute('data-open') === 'true' && !bar.contains(e.target)) setOpen(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && bar.getAttribute('data-open') === 'true') { setOpen(false); toggle.focus(); }
    });
  })();
</script>
