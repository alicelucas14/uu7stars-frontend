---
// ===== src/components/SidebarCta.astro =====

import type { Locale } from '../i18n';
import { useTranslations } from '../lib/i18n';
import { createPath } from '../lib/paths';

interface Props {
  lang?: Locale;
}
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const downloadPath = createPath('/download/', lang);
---
<div class="sidebar-cta-card">
  <img src="/logo.webp" alt="Starsuu7 Logo" width="60" height="60" loading="lazy" />
  <h3>{t('downloadCta.title')}</h3>
  <p>{t('downloadCta.bonusInfo')}</p>
  <a href={downloadPath} class="btn-dl">{t('downloadCta.mainCta')}</a>
</div>
<style>
.sidebar-cta-card{position:relative;overflow:hidden;text-align:center;color:#fff;padding:28px 22px 24px;border-radius:28px;display:grid;justify-items:center;gap:12px;background:radial-gradient(70% 90% at 100% 0%,rgba(250,204,21,.4),transparent 60%),linear-gradient(150deg,#f97316 0%,#ea580c 100%);box-shadow:0 30px 50px -32px rgba(124,45,18,.7),inset 0 1px 0 rgba(255,255,255,.3)}
.sidebar-cta-card img{border-radius:16px;filter:drop-shadow(0 8px 14px rgba(67,20,7,.35))}
.sidebar-cta-card h3{color:#fff;font-size:20px;line-height:1.25;margin:0;text-shadow:0 2px 12px rgba(124,45,18,.3)}
.sidebar-cta-card p{color:rgba(255,255,255,.95);margin:0;font-size:14px}
.btn-dl{display:inline-flex;align-items:center;justify-content:center;padding:12px 24px;margin-top:4px;border-radius:999px;text-decoration:none;font-weight:800;font-size:14px;letter-spacing:.2px;color:#431407;background:linear-gradient(180deg,#fff3a3 0%,var(--brand-gold) 48%,#f59e0b 100%);box-shadow:0 14px 24px -12px rgba(67,20,7,.7),inset 0 1px 0 rgba(255,255,255,.85),inset 0 -2px 0 rgba(180,83,9,.22);transition:transform .2s ease,filter .2s ease}
.btn-dl:hover{transform:translateY(-2px);filter:brightness(1.04)}
</style>
