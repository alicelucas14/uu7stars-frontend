---
// ===== src/components/Promotions.astro =====
// --- REFACTORED: Now uses the centralized 'useTranslations' utility ---

import type { Locale } from '../i18n';
import { useTranslations } from '../lib/i18n';
import { createPath } from '../lib/paths';

interface Props {
  lang?: Locale;
}
const { lang = 'en' } = Astro.props as Props;
const t = useTranslations(lang);

// --- UPDATED: Fetch all content dynamically from the locale file ---
const title = t('promotions.title');
const description = t('promotions.description');
const viewAllText = t('promotions.viewAll');

// Type-safe check for the steps array
const stepsResult = t('promotions.steps');
const promoSteps: { num: number; title: string; body: string }[] = Array.isArray(stepsResult) 
  ? stepsResult.map((step, index) => ({ ...step, num: index + 1 })) 
  : [];

// small icon per step (any extra steps added in the locale file fall back to a spark)
const STEP_ICONS = [
  '<path d="M15 19a6 6 0 0 0-12 0"/><circle cx="9" cy="8" r="3.5"/><path d="M19 8v6M16 11h6"/>',
  '<path d="M20 12v8H4v-8M2 7h20v5H2zM12 22V7M12 7H8a2.5 2.5 0 1 1 0-5c2.5 0 4 5 4 5zM12 7h4a2.5 2.5 0 1 0 0-5c-2.5 0-4 5-4 5z"/>',
  '<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4z"/><path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"/>',
];
const SPARK = '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/>';
const allPromosPath = createPath('/promotions/', lang);

---
<section class="promos-section-steps">
  <div class="container">
    <header class="section-head">
      <h2>{title}</h2>
      <p class="muted">{description}</p>
    </header>

    <ol class="grid">
      {promoSteps.map((step, i) => (
        <li class="step-card" data-num={step.num}>
          <div class="number" aria-hidden="true">{step.num}</div>
          <h3 class="title">{step.title}</h3>
          <p class="body">{step.body}</p>
          <svg class="step-ico" viewBox="0 0 24 24" aria-hidden="true" set:html={STEP_ICONS[i] ?? SPARK}></svg>
        </li>
      ))}
    </ol>

    <div class="more-link-container">
      <a href={allPromosPath} class="btn-view-all">
        {viewAllText}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .promos-section-steps {
    padding-block: 64px 72px;
    background: linear-gradient(180deg, var(--surface) 0%, color-mix(in oklab, var(--brand-orange) 5%, var(--surface)) 100%);
    border-top: 1px solid var(--ring);
  }
  .section-head { text-align: center; max-width: 640px; margin-inline: auto; margin-bottom: 40px; }
  .section-head h2 { font-size: clamp(26px, 4vw, 38px); letter-spacing: -.02em; margin-bottom: 10px; }
  /* short brand accent under the heading */
  .section-head h2::after { content: ""; display: block; width: 48px; height: 4px; margin: 14px auto 0; border-radius: 4px; background: linear-gradient(90deg, var(--brand-orange), var(--brand-gold)); }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 22px; }

  .step-card {
    position: relative; overflow: hidden; isolation: isolate;
    padding: 28px 24px 26px; text-align: left;
    background: #fff;
    border: 1px solid color-mix(in oklab, var(--brand-orange) 16%, #fff);
    border-radius: 24px;
    box-shadow: 0 24px 40px -30px rgba(124, 45, 18, .5);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  /* brand accent bar along the top edge */
  .step-card::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: linear-gradient(90deg, var(--brand-orange), var(--brand-gold)); }
  /* big faint step number in the corner */
  .step-card::after { content: attr(data-num); position: absolute; right: 16px; top: 8px; z-index: -1; font-size: 104px; line-height: 1; font-weight: 900; color: color-mix(in oklab, var(--brand-orange) 9%, transparent); }
  @media (hover: hover) and (min-width: 768px) {
    .step-card:hover { transform: translateY(-6px); border-color: color-mix(in oklab, var(--brand-orange) 35%, #fff); box-shadow: 0 32px 46px -28px rgba(124, 45, 18, .6); }
  }

  .number {
    display: inline-grid; place-items: center; width: 52px; height: 52px; margin-bottom: 18px; border-radius: 16px;
    font-size: 22px; font-weight: 850; color: #fff;
    background: linear-gradient(135deg, #fb923c, var(--brand-orange) 55%, #ea580c);
    box-shadow: 0 12px 20px -10px rgba(234, 88, 12, .75), inset 0 1px 0 rgba(255,255,255,.4);
  }
  .title { margin: 0 0 8px; font-size: 19px; line-height: 1.25; letter-spacing: -.01em; color: var(--text-primary); }
  .body { margin: 0; font-size: 15px; line-height: 1.6; color: var(--text-secondary); }
  .step-ico { position: absolute; right: 20px; bottom: 18px; width: 22px; height: 22px; fill: none; stroke: color-mix(in oklab, var(--brand-orange) 70%, #fff); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; opacity: .9; }

  .more-link-container { margin-top: 40px; text-align: center; }
  .btn-view-all {
    display: inline-flex; align-items: center; gap: 10px; padding: 14px 28px; border-radius: 999px;
    font-weight: 800; font-size: 15px; text-decoration: none; color: #431407;
    background: linear-gradient(180deg, #fff3a3 0%, var(--brand-gold) 48%, #f59e0b 100%);
    box-shadow: 0 14px 24px -12px rgba(154, 52, 18, .6), inset 0 1px 0 rgba(255,255,255,.85), inset 0 -2px 0 rgba(180, 83, 9, .22);
    transition: transform .2s ease, filter .2s ease;
  }
  .btn-view-all svg { width: 18px; height: 18px; fill: none; stroke: #9a3412; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; transition: transform .2s ease; }
  .btn-view-all:hover { transform: translateY(-2px); filter: brightness(1.04); }
  .btn-view-all:hover svg { transform: translateX(3px); }
  .btn-view-all:focus-visible { outline: 3px solid var(--brand-orange); outline-offset: 3px; }

  /* phones: compact horizontal cards, number tile on the left */
  @media (max-width: 767px) {
    .promos-section-steps { padding-block: 44px 52px; }
    .section-head { margin-bottom: 28px; }
    .grid { gap: 14px; }
    .step-card { display: grid; grid-template-columns: 48px 1fr; column-gap: 14px; align-items: start; padding: 18px 16px 18px; border-radius: 20px; }
    .number { grid-row: 1 / span 2; width: 48px; height: 48px; margin: 0; border-radius: 14px; font-size: 20px; }
    .title { font-size: 17px; margin: 2px 0 4px; }
    .body { font-size: 14px; line-height: 1.55; }
    .step-card::after { font-size: 72px; right: 12px; top: 6px; }
    .step-ico { display: none; }
    .more-link-container { margin-top: 28px; }
  }

  @media (prefers-reduced-motion: reduce) { .step-card, .btn-view-all, .btn-view-all svg { transition: none; } }
</style>
