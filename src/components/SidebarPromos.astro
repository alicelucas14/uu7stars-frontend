---
// ===== src/components/SidebarPromos.astro =====

import { getPromotions } from '../services/api';
import type { Promotion } from '../services/api';
import type { Locale } from '../i18n';
import { createPath } from '../lib/paths';

interface Props {
  limit?: number;
  lang?: Locale;
}
const { limit = 3, lang = 'en' } = Astro.props;

const promos = await getPromotions(lang).catch(() => []);
const recent = promos.filter(p => p.imageUrl).slice(0, limit);

const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;
const toAbsolute = (p?: string) => !p ? '' : (p.startsWith('http') ? p : new URL(p, API_BASE_URL).toString());
---
{recent.length > 0 && (
  <div class="sidebar-widget">
    <h3 class="widget-title">Latest Promotions</h3>
    <div class="promo-list">
      {recent.map((promo: Promotion) => (
        <a href={createPath(`/promotions/${promo.slug}/`, lang)} class="promo-item">
          <img src={toAbsolute(promo.imageUrl)} alt={`Promotion: ${promo.title}`} width="400" height="250" loading="lazy" />
          <div class="promo-info">
            <span class="promo-title">{promo.title}</span>
            <p class="promo-desc">{promo.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
)}
<style>
.sidebar-widget{position:relative;overflow:hidden;background:#fff;border:1px solid color-mix(in oklab,var(--brand-orange) 16%,#fff);border-radius:24px;padding:24px 20px 20px;box-shadow:0 24px 40px -32px rgba(124,45,18,.5)}
.sidebar-widget::before{content:"";position:absolute;left:0;right:0;top:0;height:4px;background:linear-gradient(90deg,var(--brand-orange),var(--brand-gold))}
.widget-title{margin:0 0 16px;padding:0 0 0 12px;border:0;border-left:4px solid var(--brand-orange);font-size:13px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;line-height:1.2;color:#c2410c}
.promo-list{display:grid;gap:14px}
.promo-item{text-decoration:none;display:block;background:#fff;border-radius:18px;overflow:hidden;border:1px solid color-mix(in oklab,var(--brand-orange) 16%,#fff);transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}
.promo-item:hover{transform:translateY(-3px);box-shadow:0 18px 28px -20px rgba(124,45,18,.6);border-color:color-mix(in oklab,var(--brand-orange) 45%,#fff)}
.promo-item img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block}
.promo-info{padding:12px 14px 14px}
.promo-title{font-weight:800;color:var(--text-primary);display:block;margin-bottom:4px;line-height:1.3}
.promo-desc{font-size:14px;color:var(--text-secondary);margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
</style>
