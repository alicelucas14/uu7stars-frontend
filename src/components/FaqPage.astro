---
// ===== src/components/FaqPage.astro =====
// The whole FAQ page for one language; src/pages/faq.astro (en) and src/pages/hi/faq.astro (hi) just render this.
// One source for everything on it: the long-form desktop layout, the phone accordion and the FAQPage markup.
// The content comes from the admin "FAQ" screen, with the locale files as the fallback (see lib/faq.ts).
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import MobileAppShell from './MobileAppShell.astro';
import { useTranslations } from '../lib/i18n';
import { loadFaq } from '../lib/faq';
import type { Locale } from '../i18n';

interface Props { lang: Locale; }
const locale: Locale = Astro.props.lang;
const t = useTranslations(locale);

const pageTitle = t('faqPage.title');
const pageDescription = t('faqPage.description');
const h1 = t('faqPage.h1');

const groups = await loadFaq(locale);
// Internal links to the Teen Patti and card game guides. They live here (not in the admin FAQ text), so they always show,
// whatever the admin FAQ contains. Every target is a published blog post in both languages.
const guides = locale === 'hi'
  ? {
      title: 'तीन पत्ती और कार्ड गेम गाइड',
      intro: 'खेलना सीखने के लिए हमारी गाइड पढ़ें।',
      links: [
        { href: '/hi/blog/teen-patti-master/', label: 'Teen Patti Master गाइड' },
        { href: '/hi/blog/how-to-play-rummy/', label: 'ऑनलाइन रम्मी की शुरुआती गाइड' },
        { href: '/hi/blog/real-money-rummy-guide-for-beginners-rules-tips-strategy/', label: 'असली पैसे वाली रम्मी: नियम, टिप्स और स्ट्रेटेजी' },
        { href: '/hi/blog/rummy-gold-tips-and-tricks/', label: 'Rummy Gold टिप्स और ट्रिक्स' },
        { href: '/hi/blog/pusoy-go-vs-card-apps/', label: 'पुसोय गो बनाम कार्ड गेम ऐप्स' },
      ],
    }
  : {
      title: 'Teen Patti and card game guides',
      intro: 'New to a game? Read our guides before you play.',
      links: [
        { href: '/blog/teen-patti-master/', label: 'Teen Patti Master guide' },
        { href: '/blog/how-to-play-rummy/', label: "A beginner's guide to online rummy" },
        { href: '/blog/real-money-rummy-guide-for-beginners-rules-tips-strategy/', label: 'Real money rummy: rules, tips and strategy' },
        { href: '/blog/rummy-gold-tips-and-tricks/', label: 'Rummy Gold tips and tricks' },
        { href: '/blog/pusoy-go-vs-card-apps/', label: 'Pusoy Go vs card game apps' },
      ],
    };
const canonical = new URL(locale === 'hi' ? '/hi/faq/' : '/faq/', Astro.site).toString();

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": groups.flatMap((group) => group.items).map(({ q, text }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": text }
  }))
};
---

<Base title={pageTitle} description={pageDescription} canonical={canonical} jsonLd={faqJsonLd}>
  <div class="header-slot"><Header lang={locale} /></div>
  <div class="mobile-only"><MobileAppShell title="FAQ" active="faq" lang={locale} /></div>

  <div class="faq-page clear-social-bar">
    <div class="container">
      <h1 class="page-title">{h1}</h1>

      <div class="content-box">
        {groups.map((group) => (
          <section class="faq-group">
            {/* The heading is shared by both layouts so its id exists once and works on desktop and phone. */}
            {group.title && <h2 id={group.id}>{group.title}</h2>}

            {/* --- DESKTOP LAYOUT (long-form content) --- */}
            <div class="desktop-layout">
              {group.items.map((item) => (
                <article class="qa">
                  <span class="qa-no" aria-hidden="true"></span>
                  <div class="qa-body">
                    <h3>{item.q}</h3>
                    <div class="rich" set:html={item.html} />
                  </div>
                </article>
              ))}
            </div>

            {/* --- MOBILE LAYOUT (accordion content) --- */}
            <div class="mobile-layout">
              {group.items.map((item) => (
                <details class="faq-item">
                  <summary>
                    <span class="question">{item.q}</span>
                    <svg class="icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                  </summary>
                  <div class="answer">
                    <div class="rich" set:html={item.html} />
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>

      <nav class="guides" aria-labelledby="faq-guides-title">
        <h2 id="faq-guides-title">{guides.title}</h2>
        <p>{guides.intro}</p>
        <ul>
          {guides.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </div>

  <Footer lang={locale} />
</Base>

<style>
  .desktop-layout { display: block; }
  .mobile-layout { display: none; }
  .desktop-only { display: block; }
  .mobile-only { display: none; }
  @media (max-width: 767px) {
    .desktop-layout { display: none; }
    .mobile-layout { display: block; }
    .desktop-only { display: none; }
    .mobile-only { display: block; }
  }

  .faq-page { padding-block: 56px 88px; background: linear-gradient(180deg, color-mix(in oklab, var(--brand-orange) 6%, var(--surface)) 0%, var(--surface) 380px); }
  /* phones: the app bar is fixed and a 61px spacer sits above the page; let the page tint run up behind the bar so there is no white band */
  @media (max-width: 767px) { .faq-page { margin-top: calc(-61px - env(safe-area-inset-top)); padding-block: calc(61px + env(safe-area-inset-top) + 24px) 48px; } }

  .page-title { margin: 0 0 40px; font-size: clamp(28px, 4.2vw, 42px); letter-spacing: -.02em; text-align: center; color: var(--text-primary); }
  .page-title::after { content: ""; display: block; width: 48px; height: 4px; margin: 14px auto 0; border-radius: 4px; background: linear-gradient(90deg, var(--brand-orange), var(--brand-gold)); }
  .content-box { max-width: 920px; margin-inline: auto; }

  .faq-group + .faq-group { margin-top: 56px; }
  /* group headings: brand bar on the left; keep a jumped-to heading (/faq/#compliance) clear of the sticky header (64px) / phone app bar (60px) */
  h2 { margin: 0 0 22px; padding-left: 14px; border-left: 4px solid var(--brand-orange); font-size: clamp(22px, 3vw, 28px); line-height: 1.2; letter-spacing: -.015em; color: var(--text-primary); scroll-margin-top: 84px; }

  /* desktop: every question is a numbered card with its full answer (all text stays on the page) */
  .desktop-layout { counter-reset: qa; }
  .qa {
    counter-increment: qa;
    display: grid; grid-template-columns: 46px 1fr; gap: 18px; align-items: start;
    margin-bottom: 16px; padding: 24px 26px 24px 22px;
    background: #fff; border: 1px solid color-mix(in oklab, var(--brand-orange) 14%, #fff); border-radius: 22px;
    box-shadow: 0 22px 38px -30px rgba(124, 45, 18, .5);
    transition: border-color .25s ease, box-shadow .25s ease;
  }
  @media (hover: hover) { .qa:hover { border-color: color-mix(in oklab, var(--brand-orange) 40%, #fff); box-shadow: 0 28px 44px -28px rgba(124, 45, 18, .6); } }
  .qa-no, .faq-item summary::before {
    display: grid; place-items: center; flex: none; width: 46px; height: 46px; border-radius: 15px;
    font-size: 15px; font-weight: 800; color: #fff;
    background: linear-gradient(135deg, #fb923c, var(--brand-orange) 55%, #ea580c);
    box-shadow: 0 12px 20px -10px rgba(234, 88, 12, .8), inset 0 1px 0 rgba(255,255,255,.4);
  }
  .qa-no::before { content: counter(qa, decimal-leading-zero); }
  h3 { margin: 4px 0 10px; font-size: 19px; line-height: 1.3; letter-spacing: -.01em; color: var(--text-primary); }

  /* answers are rendered Markdown (set:html), so these rules must reach elements Astro did not create */
  .rich { color: var(--text-secondary); font-size: 16px; line-height: 1.75; }
  .rich :global(p), .rich :global(ul), .rich :global(ol) { margin: 0 0 1em; }
  .rich :global(ul), .rich :global(ol) { padding-left: 24px; }
  .rich :global(li) { margin-bottom: 6px; }
  .rich :global(li::marker) { color: var(--brand-orange); font-weight: 700; }
  .rich :global(a) { color: #c2410c; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: color-mix(in oklab, var(--brand-orange) 45%, transparent); }
  .rich :global(strong) { color: var(--text-primary); }
  .rich > :global(:last-child) { margin-bottom: 0; }

  /* phones: the same numbered accordion as on the home page */
  .mobile-layout { counter-reset: qm; }
  .faq-item {
    counter-increment: qm; margin-bottom: 12px; overflow: hidden;
    background: #fff; border: 1px solid color-mix(in oklab, var(--brand-orange) 14%, #fff); border-radius: 20px;
    transition: border-color .25s ease, box-shadow .25s ease, background-color .25s ease;
  }
  .faq-item[open] {
    border-color: color-mix(in oklab, var(--brand-orange) 42%, #fff);
    background: linear-gradient(180deg, color-mix(in oklab, var(--brand-orange) 5%, #fff), #fff 120px);
    box-shadow: 0 22px 36px -28px rgba(124, 45, 18, .6);
  }
  summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 12px; padding: 14px 14px; -webkit-tap-highlight-color: transparent; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 3px solid var(--brand-orange); outline-offset: -3px; border-radius: 20px; }
  .faq-item summary::before { content: counter(qm, decimal-leading-zero); width: 36px; height: 36px; border-radius: 12px; font-size: 13px; color: #c2410c; background: linear-gradient(135deg, #fff1e0, #ffe1bd); box-shadow: inset 0 0 0 1px rgba(249, 115, 22, .18); }
  .faq-item[open] summary::before { color: #fff; background: linear-gradient(135deg, #fb923c, var(--brand-orange) 55%, #ea580c); box-shadow: 0 10px 18px -10px rgba(234, 88, 12, .8), inset 0 1px 0 rgba(255,255,255,.4); }
  .question { flex: 1; min-width: 0; font-size: 15px; font-weight: 750; line-height: 1.35; color: var(--text-primary); }
  .icon { flex: none; width: 32px; height: 32px; padding: 7px; border-radius: 50%; color: var(--brand-orange); background: color-mix(in oklab, var(--brand-orange) 10%, #fff); stroke: currentColor; stroke-width: 2.6; fill: none; stroke-linecap: round; stroke-linejoin: round; transition: transform .25s ease; }
  .faq-item[open] .icon { transform: rotate(180deg); }
  .answer { padding: 0 16px 18px; }
  .answer .rich { font-size: 14.5px; }

  /* guides: links as brand chips */
  .guides {
    position: relative; overflow: hidden; max-width: 920px; margin: 56px auto 0; padding: clamp(24px, 4vw, 36px);
    background: #fff; border: 1px solid color-mix(in oklab, var(--brand-orange) 16%, #fff); border-radius: 28px;
    box-shadow: 0 30px 50px -36px rgba(124, 45, 18, .55);
  }
  .guides::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: linear-gradient(90deg, var(--brand-orange), var(--brand-gold)); }
  .guides h2 { margin-bottom: 8px; }
  .guides p { margin: 0 0 20px; padding-left: 18px; color: var(--text-secondary); }
  .guides ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px; }
  .guides a {
    display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 16px; border-radius: 16px;
    font-weight: 700; font-size: 15px; line-height: 1.35; text-decoration: none; color: #9a3412;
    background: color-mix(in oklab, var(--brand-orange) 8%, #fff); border: 1px solid color-mix(in oklab, var(--brand-orange) 22%, #fff);
    transition: background-color .2s ease, color .2s ease, border-color .2s ease;
  }
  .guides a::after { content: "\2192"; flex: none; font-weight: 800; transition: transform .2s ease; }
  .guides a:hover { color: #fff; background: var(--brand-orange); border-color: var(--brand-orange); }
  .guides a:hover::after { transform: translateX(4px); }
  @media (max-width: 767px) {
    .content-box { max-width: none; }
    .guides { margin-top: 36px; border-radius: 24px; }
    .guides ul { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .qa, .faq-item, .icon, .guides a, .guides a::after { transition: none; } }
</style>
