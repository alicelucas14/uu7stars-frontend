---
/**
 * "Guides" section for the top of the blog page: the guides grouped by topic.
 * English uses the supplied titles and notes; Hindi uses the Hindi post titles from the API.
 */
import { GUIDE_GROUPS } from '../lib/guides';
import { createPath } from '../lib/paths';
import { getBlogPosts } from '../services/api';
import { useTranslations } from '../lib/i18n';
import type { Locale } from '../i18n';

interface Props { lang?: Locale }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

let hiTitles = new Map<string, string>();
if (lang === 'hi') {
  try {
    const posts = await getBlogPosts('hi');
    hiTitles = new Map(posts.filter((p) => p.slug && p.title).map((p) => [p.slug, p.title]));
  } catch { /* fall back to the English titles */ }
}
const label = (g: { slug: string; title: string }) => (lang === 'hi' ? hiTitles.get(g.slug) ?? g.title : g.title);
---
<section class="guides-section" aria-labelledby="guides-title">
  <h2 id="guides-title">{t('guides.title')}</h2>
  <p class="guides-intro">{t('guides.intro')}</p>
  {GUIDE_GROUPS.map((group) => (
    <div class="guide-group">
      <h3>{t(`guides.groups.${group.key}`)}</h3>
      <ul>
        {group.guides.map((g) => (
          <li>
            <a href={createPath(g.path ?? `/blog/${g.slug}/`, lang)}>{label(g)}</a>
            {lang === 'en' && <span class="guide-note">{g.note}</span>}
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>
<style>
  .guides-section {
    position: relative; overflow: hidden; margin: 0 0 48px; padding: clamp(24px, 4vw, 40px);
    background: #fff; border: 1px solid color-mix(in oklab, var(--brand-orange) 16%, #fff); border-radius: 28px;
    box-shadow: 0 30px 50px -36px rgba(124, 45, 18, .55);
  }
  .guides-section::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: linear-gradient(90deg, var(--brand-orange), var(--brand-gold)); }
  .guides-section h2 { margin: 0 0 8px; font-size: clamp(24px, 3vw, 32px); letter-spacing: -.02em; }
  .guides-intro { margin: 0 0 24px; color: var(--text-secondary); }
  .guide-group + .guide-group { margin-top: 22px; }
  .guide-group h3 { margin: 0 0 10px; padding-left: 12px; border-left: 4px solid var(--brand-orange); font-size: 13px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: #c2410c; line-height: 1.2; }
  .guide-group ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 10px; }
  /* each guide is one tappable tile: the link stretches over the whole tile */
  .guide-group li {
    position: relative; display: flex; flex-direction: column; gap: 3px; padding: 13px 40px 13px 16px; border-radius: 16px;
    background: color-mix(in oklab, var(--brand-orange) 6%, #fff); border: 1px solid color-mix(in oklab, var(--brand-orange) 20%, #fff);
    transition: background-color .2s ease, border-color .2s ease, transform .2s ease;
  }
  .guide-group li::after { content: "\2192"; position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font-weight: 800; color: #c2410c; transition: transform .2s ease; }
  .guide-group a { font-weight: 800; font-size: 15px; line-height: 1.3; color: var(--text-primary); text-decoration: none; }
  .guide-group a::before { content: ""; position: absolute; inset: 0; border-radius: 16px; }
  .guide-group a:focus-visible { outline: none; }
  .guide-group li:focus-within { outline: 3px solid var(--brand-orange); outline-offset: 2px; }
  .guide-note { font-size: 13px; line-height: 1.4; color: var(--text-secondary); }
  @media (hover: hover) and (min-width: 768px) {
    .guide-group li:hover { background: #fff; border-color: color-mix(in oklab, var(--brand-orange) 45%, #fff); transform: translateY(-2px); }
    .guide-group li:hover::after { transform: translate(4px, -50%); }
    .guide-group li:hover a { color: #c2410c; }
  }
  @media (max-width: 767px) { .guides-section { padding: 22px 16px; border-radius: 24px; margin-bottom: 32px; } .guide-group ul { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .guide-group li, .guide-group li::after { transition: none; } }
</style>
