---
// ===== src/components/FAQ.astro =====
// --- REFACTORED: Now uses the centralized 'useTranslations' utility ---
// --- FIXED: Added type-safe handling for the FAQ list ---

import type { Locale } from '../i18n';
import { useTranslations } from '../lib/i18n';
import { createPath } from '../lib/paths';

interface Props {
  lang?: Locale;
}
const { lang = 'en' } = Astro.props as Props;

const t = useTranslations(lang);

const title = t('faq.title');
const description = t('faq.description');
const viewAllText = t('faq.viewAll');

// --- THE FIX: Check if the returned value is an array before assigning it ---
const faqListResult = t('faq.list');
const faqs: { q: string; a: string }[] = Array.isArray(faqListResult) ? faqListResult : [];

const allFaqPath = createPath('/faq/', lang);
---
<section id="faq" class="faq-section">
  <div class="container">
    <header class="section-head">
      <h2>{title}</h2>
      <p class="muted">{description}</p>
    </header>

    <div class="accordion">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary>
            <span class="question">{faq.q}</span>
            <svg class="icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="answer">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>

    <div class="more-link-container">
      <a href={allFaqPath} class="btn-view-all">
        {viewAllText}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>

  </div>
</section>

<style>
  .faq-section {
    padding-block: 64px 72px;
    background: linear-gradient(180deg, var(--surface) 0%, color-mix(in oklab, var(--brand-orange) 5%, var(--surface)) 100%);
    border-top: 1px solid var(--ring);
    border-bottom: 1px solid var(--ring);
  }
  .section-head { text-align: center; max-width: 720px; margin-inline: auto; margin-bottom: 40px; }
  .section-head h2 { font-size: clamp(26px, 4vw, 38px); letter-spacing: -.02em; margin-bottom: 10px; }
  .section-head h2::after { content: ""; display: block; width: 48px; height: 4px; margin: 14px auto 0; border-radius: 4px; background: linear-gradient(90deg, var(--brand-orange), var(--brand-gold)); }

  .accordion { counter-reset: faq; max-width: 820px; margin-inline: auto; display: grid; gap: 12px; }

  .faq-item {
    counter-increment: faq;
    background: #fff;
    border: 1px solid color-mix(in oklab, var(--brand-orange) 14%, #fff);
    border-radius: 20px; overflow: hidden;
    transition: border-color .25s ease, box-shadow .25s ease, background-color .25s ease;
  }
  .faq-item[open] {
    border-color: color-mix(in oklab, var(--brand-orange) 42%, #fff);
    background: linear-gradient(180deg, color-mix(in oklab, var(--brand-orange) 5%, #fff), #fff 120px);
    box-shadow: 0 22px 36px -28px rgba(124, 45, 18, .6);
  }
  summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; gap: 14px; padding: 16px 18px;
    -webkit-tap-highlight-color: transparent;
  }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 3px solid var(--brand-orange); outline-offset: -3px; border-radius: 20px; }
  /* orange number tile in front of each question */
  summary::before {
    content: counter(faq, decimal-leading-zero);
    display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 13px;
    font-size: 14px; font-weight: 800; color: #c2410c; background: linear-gradient(135deg, #fff1e0, #ffe1bd); box-shadow: inset 0 0 0 1px rgba(249, 115, 22, .18);
    transition: background .25s ease, color .25s ease, box-shadow .25s ease;
  }
  .faq-item[open] summary::before { color: #fff; background: linear-gradient(135deg, #fb923c, var(--brand-orange) 55%, #ea580c); box-shadow: 0 10px 18px -10px rgba(234, 88, 12, .8), inset 0 1px 0 rgba(255,255,255,.4); }
  .question { flex: 1; min-width: 0; font-size: 16px; font-weight: 750; line-height: 1.35; color: var(--text-primary); }
  .icon {
    flex: none; width: 32px; height: 32px; padding: 7px; border-radius: 50%;
    color: var(--brand-orange); background: color-mix(in oklab, var(--brand-orange) 10%, #fff);
    stroke: currentColor; stroke-width: 2.6; fill: none; stroke-linecap: round; stroke-linejoin: round;
    transition: transform .25s ease;
  }
  .faq-item[open] .icon { transform: rotate(180deg); }
  .answer { padding: 0 20px 22px 72px; color: var(--text-secondary); font-size: 15px; line-height: 1.7; }
  .answer p { margin: 0; }

  .more-link-container { margin-top: 40px; text-align: center; }
  .btn-view-all {
    display: inline-flex; align-items: center; gap: 10px; padding: 14px 28px; border-radius: 999px;
    font-weight: 800; font-size: 15px; text-decoration: none; color: #431407;
    background: linear-gradient(180deg, #fff3a3 0%, var(--brand-gold) 48%, #f59e0b 100%);
    box-shadow: 0 14px 24px -12px rgba(154, 52, 18, .6), inset 0 1px 0 rgba(255,255,255,.85), inset 0 -2px 0 rgba(180, 83, 9, .22);
    transition: transform .2s ease, filter .2s ease;
  }
  .btn-view-all svg { width: 18px; height: 18px; fill: none; stroke: #9a3412; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; transition: transform .2s ease; }
  .btn-view-all:hover { transform: translateY(-2px); filter: brightness(1.04); }
  .btn-view-all:hover svg { transform: translateX(3px); }
  .btn-view-all:focus-visible { outline: 3px solid var(--brand-orange); outline-offset: 3px; }

  @media (max-width: 767px) {
    .faq-section { padding-block: 44px 52px; }
    .section-head { margin-bottom: 26px; }
    summary { padding: 14px 14px; gap: 12px; }
    summary::before { width: 36px; height: 36px; border-radius: 12px; font-size: 13px; }
    .question { font-size: 15px; }
    .answer { padding: 0 16px 18px 16px; font-size: 14.5px; }
  }
  @media (prefers-reduced-motion: reduce) { .faq-item, summary::before, .icon, .btn-view-all, .btn-view-all svg { transition: none; } }
</style>
