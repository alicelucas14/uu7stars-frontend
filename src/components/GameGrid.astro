---
// ===== src/components/GameGrid.astro =====
// --- REFACTORED: Now uses the centralized 'useTranslations' utility. ---

import { getReviews } from '../services/api';
import type { ReviewListItem } from '../services/api';
import type { Locale } from '../i18n';
import { useTranslations } from '../lib/i18n'; // <-- IMPORT the new utility
import { createPath } from '../lib/paths';

interface Props {
  lang?: Locale;
}
const { lang = 'en' } = Astro.props as Props;

// --- UPDATED: Get the translation function for the current language ---
const t = useTranslations(lang);

const allReviews = await getReviews(lang).catch(() => []);
const reviews = allReviews.filter(r => r.image).slice(0, 8);

const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

// "4.8" style score for the badge; empty when a review has no usable rating
function score(rating: number): string {
  const num = Number(rating);
  return Number.isFinite(num) && num > 0 ? num.toFixed(1) : '';
}
const allReviewsPath = createPath('/reviews/', lang);
---
<section id="games" class="game-grid-section">
  <div class="container">
    <header class="section-head">
      <h2>{t('gameGrid.title')}</h2>
      <p class="muted">{t('gameGrid.description')}</p>
    </header>

    <div class="grid">
      {reviews.map((review: ReviewListItem) => {
        const imageUrl = review.image.startsWith('http') ? review.image : `${API_BASE_URL}${review.image}`;
        const reviewUrl = createPath(`/reviews/${review.slug}/`, lang);
        const rating = score(review.rating);

        return (
          <a href={reviewUrl} class="game-card">
            <img src={imageUrl} alt={review.title} class="art" loading="lazy" width="300" height="400" />
            {rating && (
              <span class="badge" aria-label={`Rating: ${review.rating} out of 5 stars`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg>
                {rating}
              </span>
            )}
            <div class="panel">
              <span class="category">{review.gameName}</span>
              <h3 class="title">{review.title}</h3>
              <span class="cta">
                {t('gameGrid.cta')}
                <span class="arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
              </span>
            </div>
          </a>
        );
      })}
    </div>

    <div class="more-link-container">
      <a href={allReviewsPath} class="btn-view-all">
        {t('gameGrid.seeAll')}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .game-grid-section {
    padding-block: 64px 72px;
    background: linear-gradient(180deg, color-mix(in oklab, var(--brand-orange) 5%, var(--surface)) 0%, var(--surface) 100%);
    border-top: 1px solid var(--ring);
  }
  .section-head { text-align: center; max-width: 640px; margin-inline: auto; margin-bottom: 40px; }
  .section-head h2 { font-size: clamp(26px, 4vw, 38px); letter-spacing: -.02em; margin-bottom: 10px; }
  .section-head h2::after { content: ""; display: block; width: 48px; height: 4px; margin: 14px auto 0; border-radius: 4px; background: linear-gradient(90deg, var(--brand-orange), var(--brand-gold)); }

  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  @media (min-width: 768px) { .grid { grid-template-columns: repeat(3, 1fr); gap: 22px; } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(4, 1fr); } }

  .game-card {
    position: relative; display: block; isolation: isolate;
    aspect-ratio: 3 / 4; overflow: hidden; text-decoration: none;
    border-radius: 24px; border: 1px solid color-mix(in oklab, var(--brand-orange) 18%, #fff);
    background: #2b1105;
    box-shadow: 0 26px 40px -28px rgba(124, 45, 18, .6);
    transition: transform .3s ease, box-shadow .3s ease;
  }
  .art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform .5s cubic-bezier(.22,1,.36,1); }

  /* score badge */
  .badge {
    position: absolute; top: 12px; left: 12px; z-index: 2;
    display: inline-flex; align-items: center; gap: 5px; padding: 5px 11px 5px 8px; border-radius: 999px;
    font-size: 13px; font-weight: 800; line-height: 1; color: #431407;
    background: linear-gradient(180deg, #fff3a3, var(--brand-gold) 60%, #f59e0b);
    box-shadow: 0 8px 16px -8px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.8);
  }
  .badge svg { width: 14px; height: 14px; fill: #b45309; stroke: #b45309; stroke-width: 1.5; stroke-linejoin: round; }

  /* text sits on a warm dark fade at the bottom of the poster */
  .panel {
    position: absolute; inset-inline: 0; bottom: 0; z-index: 1; display: grid; gap: 4px;
    padding: 56px 16px 16px;
    background: linear-gradient(0deg, rgba(43, 17, 5, .94) 0%, rgba(43, 17, 5, .78) 45%, rgba(43, 17, 5, 0) 100%);
  }
  .category { font-size: 11.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #fde68a; }
  .title { margin: 0; font-size: 18px; line-height: 1.25; font-weight: 800; color: #fff; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cta { display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; font-size: 13px; font-weight: 700; color: #fff; }
  .arrow { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; color: #431407; background: var(--brand-gold); transition: transform .25s ease; }
  .arrow svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2.8; stroke-linecap: round; stroke-linejoin: round; }

  @media (hover: hover) and (min-width: 768px) {
    .game-card:hover { transform: translateY(-8px); box-shadow: 0 34px 48px -26px rgba(124, 45, 18, .75); }
    .game-card:hover .art { transform: scale(1.06); }
    .game-card:hover .arrow { transform: translateX(4px); }
  }
  .game-card:focus-visible { outline: 3px solid var(--brand-orange); outline-offset: 3px; }

  .more-link-container { margin-top: 40px; text-align: center; }
  .btn-view-all {
    display: inline-flex; align-items: center; gap: 10px; padding: 14px 28px; border-radius: 999px;
    font-weight: 800; font-size: 15px; text-decoration: none; color: #431407;
    background: linear-gradient(180deg, #fff3a3 0%, var(--brand-gold) 48%, #f59e0b 100%);
    box-shadow: 0 14px 24px -12px rgba(154, 52, 18, .6), inset 0 1px 0 rgba(255,255,255,.85), inset 0 -2px 0 rgba(180, 83, 9, .22);
    transition: transform .2s ease, filter .2s ease;
  }
  .btn-view-all svg { width: 18px; height: 18px; fill: none; stroke: #9a3412; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; transition: transform .2s ease; }
  .btn-view-all:hover { transform: translateY(-2px); filter: brightness(1.04); }
  .btn-view-all:hover svg { transform: translateX(3px); }
  .btn-view-all:focus-visible { outline: 3px solid var(--brand-orange); outline-offset: 3px; }

  /* phones: one swipeable row of posters that bleeds to both screen edges (first and last card stay on the page margin) */
  @media (max-width: 767px) {
    .game-grid-section { padding-block: 44px 52px; }
    .section-head { margin-bottom: 26px; }
    .grid {
      display: grid; grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: min(62vw, 240px); gap: 12px;
      margin-inline: calc(50% - 50vw); padding-inline: calc(50vw - 50%); padding-block: 4px 10px;
      overflow-x: auto; overflow-y: hidden; scroll-snap-type: x proximity; scroll-padding-inline: 16px;
      overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; -ms-overflow-style: none; scrollbar-width: none;
    }
    .grid::-webkit-scrollbar { display: none; }
    .game-card { scroll-snap-align: start; border-radius: 20px; box-shadow: none; }
    .panel { padding: 48px 12px 12px; }
    .title { font-size: 16px; }
    .more-link-container { margin-top: 22px; }
  }

  @media (prefers-reduced-motion: reduce) { .game-card, .art, .arrow, .btn-view-all, .btn-view-all svg { transition: none; } }
</style>
