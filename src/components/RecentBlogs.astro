---
// ===== src/components/RecentBlogs.astro =====
// --- REFACTORED: Now uses the centralized 'useTranslations' utility ---

import { getBlogPosts } from '../services/api';
import type { BlogPostListItem } from '../services/api';
import type { Locale } from '../i18n';
import { useTranslations } from '../lib/i18n';
import { createPath } from '../lib/paths';

interface Props {
  lang?: Locale;
}
const { lang = 'en' } = Astro.props as Props;
const t = useTranslations(lang);

// --- UPDATED: Fetch localized blog posts based on the 'lang' prop ---
const allPosts = await getBlogPosts(lang).catch(() => []);
const recentPosts = allPosts.filter(post => post.image).slice(0, 3);

const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

// Excerpts are Markdown in the CMS; show them as plain text in the card.
const plain = (md: string) => String(md ?? '').replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/[*_`#>]/g, '').replace(/\s+/g, ' ').trim();
const dateLocale = lang === 'hi' ? 'hi-IN' : 'en-IN';
// the label strings may already end in an arrow; the button draws its own
const noArrow = (txt: string) => String(txt).replace(/\s*(?:→|&rarr;|›|»)+\s*$/u, '');
---
{/* Only render the section if there are posts to display */}
{recentPosts.length > 0 && (
  <section class="recent-blogs-section">
    <div class="container">
      <header class="section-head">
        <div class="head-text">
          <h2>{t('recentBlogs.title')}</h2>
          <p class="muted">{t('recentBlogs.description')}</p>
        </div>
        <a href={createPath('/blog/', lang)} class="btn-view-all">
          {noArrow(t('recentBlogs.viewAll'))}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </header>

      <div class="post-grid">
        {recentPosts.map((post: BlogPostListItem) => {
          // Posts come from the lang-specific list, so link to that language's URL (with the trailing slash - no 301)
          const postUrl = createPath(`/blog/${post.slug}/`, lang);
          const imageUrl = post.image.startsWith('http') ? post.image : `${API_BASE_URL}${post.image}`;
          const formattedDate = new Date(post.publishedAt).toLocaleDateString(dateLocale, {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          });

          return (
            <article class="post-card">
              <a href={postUrl} class="card-image-link" aria-label={`Read more about ${post.title}`}>
                <img src={imageUrl} alt="" loading="lazy" width="400" height="250" class="card-image" />
                <time class="date-chip" datetime={post.publishedAt}>{formattedDate}</time>
              </a>
              <div class="card-content">
                <h3 class="card-title">
                  <a href={postUrl}>{post.title}</a>
                </h3>
                <p class="card-excerpt">{plain(post.excerpt)}</p>
                <a href={postUrl} class="read-more-link" aria-label={`Read more about ${post.title}`}>
                  {noArrow(t('recentBlogs.readMore'))}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  .recent-blogs-section {
    padding-block: 64px 72px;
    background: linear-gradient(180deg, var(--surface-2), color-mix(in oklab, var(--brand-orange) 4%, var(--surface-2)));
    border-top: 1px solid var(--ring);
  }
  .section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 24px; margin-bottom: 36px; }
  .section-head h2 { font-size: clamp(26px, 4vw, 38px); letter-spacing: -.02em; margin: 0 0 6px; }
  .section-head h2::after { content: ""; display: block; width: 48px; height: 4px; margin-top: 14px; border-radius: 4px; background: linear-gradient(90deg, var(--brand-orange), var(--brand-gold)); }
  .head-text .muted { margin: 12px 0 0; }

  .btn-view-all {
    display: inline-flex; align-items: center; gap: 8px; padding: 11px 20px; border-radius: 999px;
    font-size: 14px; font-weight: 800; text-decoration: none; color: #c2410c; background: #fff;
    border: 1.5px solid color-mix(in oklab, var(--brand-orange) 45%, #fff);
    transition: background-color .2s ease, color .2s ease, border-color .2s ease, transform .2s ease;
  }
  .btn-view-all svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; transition: transform .2s ease; }
  .btn-view-all:hover { color: #fff; background: var(--brand-orange); border-color: var(--brand-orange); transform: translateY(-2px); }
  .btn-view-all:hover svg { transform: translateX(3px); }

  .post-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 24px; }

  .post-card {
    display: flex; flex-direction: column; overflow: hidden;
    background: #fff; border: 1px solid color-mix(in oklab, var(--brand-orange) 14%, #fff); border-radius: 24px;
    box-shadow: 0 24px 40px -30px rgba(124, 45, 18, .5);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  @media (hover: hover) and (min-width: 768px) {
    .post-card:hover { transform: translateY(-6px); box-shadow: 0 34px 46px -28px rgba(124, 45, 18, .6); }
    .post-card:hover .card-image { transform: scale(1.05); }
  }

  .card-image-link { position: relative; display: block; overflow: hidden; }
  .card-image { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; transition: transform .5s cubic-bezier(.22,1,.36,1); }
  .date-chip {
    position: absolute; left: 12px; bottom: 12px; padding: 5px 11px; border-radius: 999px;
    font-size: 12px; font-weight: 700; color: #431407;
    background: rgba(255,255,255,.92); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    box-shadow: 0 6px 14px -8px rgba(0,0,0,.5);
  }

  .card-content { display: flex; flex-direction: column; flex-grow: 1; padding: 20px 20px 22px; }
  .card-title { margin: 0 0 8px; font-size: 19px; line-height: 1.3; font-weight: 800; letter-spacing: -.01em; }
  .card-title a { color: var(--text-primary); text-decoration: none; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .card-title a:hover { color: var(--brand-orange); }
  .card-excerpt { margin: 0; flex-grow: 1; font-size: 14.5px; line-height: 1.6; color: var(--text-secondary); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .read-more-link { display: inline-flex; align-items: center; gap: 6px; align-self: flex-start; margin-top: 16px; font-size: 14px; font-weight: 800; color: #c2410c; text-decoration: none; }
  .read-more-link svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; transition: transform .2s ease; }
  .read-more-link:hover svg { transform: translateX(4px); }

  /* phones: one swipeable row that bleeds to both screen edges */
  @media (max-width: 767px) {
    .recent-blogs-section { padding-block: 44px 52px; }
    .section-head { margin-bottom: 24px; }
    .post-grid {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: min(80vw, 320px); gap: 14px;
      margin-inline: calc(50% - 50vw); padding-inline: calc(50vw - 50%); padding-block: 4px 8px;
      overflow-x: auto; overflow-y: hidden; scroll-snap-type: x proximity; scroll-padding-inline: 16px;
      overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; -ms-overflow-style: none; scrollbar-width: none;
    }
    .post-grid::-webkit-scrollbar { display: none; }
    .post-card { scroll-snap-align: start; box-shadow: none; border-radius: 22px; }
  }

  @media (prefers-reduced-motion: reduce) { .post-card, .card-image, .btn-view-all, .btn-view-all svg, .read-more-link svg { transition: none; } }
</style>
