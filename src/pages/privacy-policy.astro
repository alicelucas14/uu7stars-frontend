---
// ===== src/pages/privacy-policy.astro =====
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileAppShell from '../components/MobileAppShell.astro';
import { useTranslations } from '../lib/i18n';
import type { Locale } from '../i18n';

const locale: Locale = 'en';
const t = useTranslations(locale);

const pageTitle = t('privacyPolicyPage.title');
const pageDescription = t('privacyPolicyPage.description');
const h1 = t('privacyPolicyPage.h1');
const lastUpdated = t('privacyPolicyPage.lastUpdated');
const sections: {title: string, content: string}[] = t('privacyPolicyPage.sections');
const canonical = new URL('/privacy-policy/', Astro.site).toString();
---

<Base title={pageTitle} description={pageDescription} canonical={canonical}>

  <div class="desktop-layout">
    <div class="header-slot"><Header lang={locale} /></div>
    <main class="legal-page clear-social-bar">
      <div class="container">
        <div class="content-box">
          <div class="h1-alt" role="heading" aria-level="1">{h1}</div>
          <p class="last-updated">{lastUpdated}</p>
          
          {sections.map(section => (
            <section>
              <h2>{section.title}</h2>
              <div set:html={section.content} />
            </section>
          ))}
        </div>
      </div>
    </main>
    <Footer lang={locale} />
  </div>

  <div class="mobile-layout">
    <MobileAppShell title={h1} showBack={true} lang={locale}>
      <main class="legal-page">
        <div class="container">
          <div class="content-box">
            <h1>{h1}</h1>
            <p class="last-updated">{lastUpdated}</p>
            
            {/* Render all sections, as mobile content is now also in the JSON */}
            {sections.map(section => (
               <section>
                <h2>{section.title}</h2>
                <div set:html={section.content} />
              </section>
            ))}
          </div>
        </div>
      </main>
    </MobileAppShell>
    <Footer lang={locale} />
  </div>
</Base>

<style>
  /* Use :global to style content from set:html */
  .legal-page :global(p), 
  .legal-page :global(ul), 
  .legal-page :global(ol) {
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 1.8;
    margin-bottom: 1em;
  }
  .legal-page :global(ul), .legal-page :global(ol) { padding-left: 24px; }
  .legal-page :global(li) { margin-bottom: 8px; }
  .legal-page :global(strong) { color: var(--text-primary); }

  /* Other styles remain unchanged */
  .desktop-layout { display: none; } .mobile-layout { display: block; } @media (min-width: 768px) { .desktop-layout { display: block; } .mobile-layout { display: none; } } .legal-page { padding-block: 48px; } @media (max-width: 767px) { .legal-page { padding-block: 24px; } .mobile-layout .content-box { border-radius: 0; border-inline: none; padding-inline: 16px; } .mobile-layout .container { padding-inline: 0; } } .content-box { background-color: var(--surface); border: 1px solid var(--ring); border-radius: 24px; padding: clamp(24px, 5vw, 48px); max-width: 900px; margin-inline: auto; } h1 , .h1-alt { font-size: clamp(28px, 4vw, 40px); margin-bottom: 8px; text-align: center; color: var(--text-primary); } .last-updated { text-align: center; color: var(--text-secondary); font-size: 14px; margin-bottom: 32px; } section { margin-bottom: 32px; } h2 { font-size: clamp(20px, 3vw, 24px); margin-top: 48px; margin-bottom: 16px; border-bottom: 1px solid var(--ring); padding-bottom: 8px; color: var(--text-primary); } h2:first-of-type { margin-top: 0; }
/* ===== modern look, shared with the rest of the site ===== */
.legal-page{background:linear-gradient(180deg,color-mix(in oklab,var(--brand-orange) 7%,var(--surface)) 0%,var(--surface) 420px);padding-block:56px 80px}
@media (max-width:767px){.legal-page{padding-block:24px 40px}}
.content-box{position:relative;overflow:hidden;background:#fff;border:1px solid color-mix(in oklab,var(--brand-orange) 14%,#fff);border-radius:32px;padding:clamp(26px,5vw,56px);box-shadow:0 34px 60px -40px rgba(124,45,18,.55)}
.content-box::before{content:"";position:absolute;inset:0 0 auto 0;height:6px;background:linear-gradient(90deg,var(--brand-orange),var(--brand-gold))}
@media (max-width:767px){.mobile-layout .content-box{border-radius:28px;border:1px solid color-mix(in oklab,var(--brand-orange) 14%,#fff);margin-inline:16px;padding:28px 20px}.mobile-layout .container{padding-inline:0}}
h1,.h1-alt{font-weight:800;letter-spacing:-.02em;line-height:1.15}
h1::after,.h1-alt::after{content:"";display:block;width:56px;height:4px;margin:14px auto 0;border-radius:4px;background:linear-gradient(90deg,var(--brand-orange),var(--brand-gold))}
.last-updated{display:table;margin:18px auto 36px;padding:6px 16px;border-radius:999px;background:color-mix(in oklab,var(--brand-orange) 9%,#fff);border:1px solid color-mix(in oklab,var(--brand-orange) 20%,#fff);color:#c2410c;font-weight:700;font-size:13px}
section{margin-bottom:8px}
h2{margin:40px 0 14px;padding:2px 0 2px 14px;border-bottom:none;border-left:4px solid var(--brand-orange);font-size:clamp(19px,2.8vw,23px);line-height:1.3;letter-spacing:-.01em}
h2:first-of-type{margin-top:0}
.legal-page :global(p),.legal-page :global(ul),.legal-page :global(ol){color:var(--text-secondary)}
.legal-page :global(li::marker){color:var(--brand-orange);font-weight:700}
.legal-page :global(a){color:#c2410c;font-weight:600;text-underline-offset:3px}
.legal-page :global(strong){color:var(--text-primary)}
</style>