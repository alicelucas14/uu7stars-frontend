---
// ===== src/pages/hi/reviews/[slug].astro =====
// --- UPDATED: Now includes the CommentsSection component ---
import { renderMarkdown } from '@lib/renderMarkdown';
import { hreflangLangs, langIsIndexable, withRealHindi } from '@lib/hreflang';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import MobileAppShell from '../../../components/MobileAppShell.astro';
import RecentPosts from '../../../components/RecentPosts.astro';
import SidebarPromos from '../../../components/SidebarPromos.astro';
import SidebarCta from '../../../components/SidebarCta.astro';
import CommentsSection from '../../../components/CommentsSection.astro'; // <-- IMPORT the component
import { redirectForRetiredSlug } from '../../../lib/slugRedirect';
import { getReviewBySlug } from '../../../services/api';
import { useTranslations } from '../../../lib/i18n';
import type { Locale } from '../../../i18n';

const locale: Locale = 'hi';
const t = useTranslations(locale);

const { slug } = Astro.params;
const review = await getReviewBySlug(slug as string, locale);

// No Hindi text yet -> no Hindi page (avoids empty/thin pages being indexed)
if (!review) {
  const moved = await redirectForRetiredSlug('reviews', slug, (s) => `/hi/reviews/${s}/`);
  if (moved) return moved;
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
if (!review.title?.hi?.trim() || !review.body?.hi?.trim()) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const ratingPercent = (review.rating / 5) * 100;
const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;
const imageUrl = review.image.startsWith('http') ? review.image : `${API_BASE_URL}${review.image}`;
const contentHtml = await renderMarkdown(review.body.hi);

const pageTitle = t('reviewPost.title').replace('{reviewTitle}', review.title.hi);
const pageDescription = t('reviewPost.description').replace('{gameName}', review.gameName);
const canonical = new URL(`/hi/reviews/${slug}/`, Astro.site).toString();

// The admin API flags finished Hindi reviews as untranslated; trust the text itself.
const seoLangs = withRealHindi(review);

const reviewJsonLd = {
  "@context": "https://schema.org",
  "@type": "Review",
  "itemReviewed": {
    "@type": "Game",
    "name": review.gameName
  },
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": review.rating,
    "bestRating": "5",
    "worstRating": "1"
  },
  "author": {
    "@type": "Organization",
    "name": "Starsuu7"
  },
  "reviewBody": review.excerpt.hi || pageDescription,
  "publisher": {
    "@type": "Organization",
    "name": "Starsuu7"
  }
};
---
<Base alternateLangs={hreflangLangs(seoLangs, Astro.site)} title={pageTitle} description={pageDescription} canonical={canonical} jsonLd={reviewJsonLd} schemaMarkup={review.schemaMarkup} robotsIndex={langIsIndexable(seoLangs, locale)}>

  <div class="desktop-layout">
    <Header lang={locale} />
    <main class="review-page clear-social-bar">
      <div class="container">
        <div class="layout-grid">
          
          <article class="main-content">
            <header class="review-header">
              <div class="h1-alt" role="heading" aria-level="1">{review.title.hi}</div>
              <p class="review-game-name" set:html={t('reviewPost.reviewOf').replace('{gameName}', review.gameName)}></p>
            </header>
            <div class="prose" set:html={contentHtml} />
            
            <!-- ADDED Comments Section for Desktop -->
            <CommentsSection reviewId={review._id} lang={locale} />

          </article>
          
          <aside class="sidebar">
            <div class="sidebar-inner">
              <div class="summary-card">
                <img src={imageUrl} alt={`Cover art for ${review.gameName}`} class="summary-image" />
                <div class="summary-content">
                  <div class="rating-box">
                    <div class="rating-score">{review.rating.toFixed(1)}</div>
                    <div class="rating-stars" aria-label={`Rating: ${review.rating} out of 5 stars`} style={`--rating-percent: ${ratingPercent}%`}></div>
                    <div class="rating-label">{t('reviewPost.ourRating')}</div>
                  </div>
                  <dl class="summary-meta">
                    <div><dt>{t('reviewPost.game')}</dt><dd>{review.gameName}</dd></div>
                    <div><dt>{t('reviewPost.developer')}</dt><dd>{review.developer}</dd></div>
                  </dl>
                  
                  {review.pros?.hi && review.pros.hi.length > 0 && (
                    <div class="pros-cons is-pros">
                      <h4>{t('reviewPost.pros')}</h4>
                      <ul>{review.pros.hi.map(pro => <li>{pro}</li>)}</ul>
                    </div>
                  )}
                   {review.cons?.hi && review.cons.hi.length > 0 && (
                    <div class="pros-cons is-cons">
                      <h4>{t('reviewPost.cons')}</h4>
                      <ul>{review.cons.hi.map(con => <li>{con}</li>)}</ul>
                    </div>
                  )}
                </div>
              </div>
              <RecentPosts lang={locale} />
              <SidebarPromos lang={locale} />
              <SidebarCta lang={locale} />
            </div>
          </aside>
        </div>
      </div>
    </main>
    <Footer lang={locale} />
  </div>

  <div class="mobile-layout">
    <MobileAppShell title="गेम समीक्षा" showBack={true} lang={locale}>
      <main class="review-page">
        <div class="container">
          <article class="main-content">
            <header class="review-header">
              <h1>{review.title.hi}</h1>
              <p class="review-game-name" set:html={t('reviewPost.reviewOf').replace('{gameName}', review.gameName)}></p>
            </header>
            <aside class="sidebar">
              <div class="summary-card">
                <img src={imageUrl} alt={`Cover art for ${review.gameName}`} class="summary-image" />
                <div class="summary-content">
                  <div class="rating-box">
                    <div class="rating-score">{review.rating.toFixed(1)}</div>
                    <div class="rating-stars" aria-label={`Rating: ${review.rating} out of 5 stars`} style={`--rating-percent: ${ratingPercent}%`}></div>
                    <div class="rating-label">{t('reviewPost.ourRating')}</div>
                  </div>
                  <dl class="summary-meta">
                    <div><dt>{t('reviewPost.game')}</dt><dd>{review.gameName}</dd></div>
                    <div><dt>{t('reviewPost.developer')}</dt><dd>{review.developer}</dd></div>
                  </dl>
                  {review.pros?.hi && review.pros.hi.length > 0 && (
                    <div class="pros-cons is-pros">
                      <h4>{t('reviewPost.pros')}</h4>
                      <ul>{review.pros.hi.map(pro => <li>{pro}</li>)}</ul>
                    </div>
                  )}
                  {review.cons?.hi && review.cons.hi.length > 0 && (
                    <div class="pros-cons is-cons">
                      <h4>{t('reviewPost.cons')}</h4>
                      <ul>{review.cons.hi.map(con => <li>{con}</li>)}</ul>
                    </div>
                  )}
                </div>
              </div>
            </aside>
            <div class="prose" set:html={contentHtml} />

            <!-- ADDED Comments Section for Mobile -->
            <CommentsSection reviewId={review._id} lang={locale} />

          </article>
        </div>
      </main>
    </MobileAppShell>
    <Footer lang={locale} />
  </div>
</Base>
<style>
  /* --- Page Layout --- */
  .desktop-layout { display: none; }
  .mobile-layout { display: block; }
  @media (min-width: 768px) {
    .desktop-layout { display: block; }
    .mobile-layout { display: none; }
  }
  .review-page { padding-block: 48px 72px; background: linear-gradient(180deg, color-mix(in oklab, var(--brand-orange) 6%, var(--surface)) 0%, var(--surface) 360px); }
  @media (max-width: 767px) {
    .review-page { padding-block: 16px 36px; }
  }

  .layout-grid { display: grid; grid-template-columns: 1fr; gap: 32px; }
  @media (min-width: 900px) { .layout-grid { grid-template-columns: minmax(0, 2fr) minmax(300px, 1fr); gap: 40px; } }
  @media (max-width: 899px) {
    .main-content { order: 2; }
    .sidebar { order: 1; }
  }

  /* --- Main Content --- */
  .review-header { margin-bottom: 28px; }
  .review-header h1, .review-header .h1-alt { margin: 0 0 14px; font-size: clamp(30px, 4.4vw, 46px); line-height: 1.12; letter-spacing: -.025em; color: var(--text-primary); }
  .review-header h1::after, .review-header .h1-alt::after { content: ""; display: block; width: 52px; height: 4px; margin-top: 16px; border-radius: 4px; background: linear-gradient(90deg, var(--brand-orange), var(--brand-gold)); }
  .review-game-name {
    display: inline-block; margin: 0; padding: 7px 16px; border-radius: 999px; font-size: 14px; color: #9a3412;
    background: color-mix(in oklab, var(--brand-orange) 11%, #fff); border: 1px solid color-mix(in oklab, var(--brand-orange) 28%, #fff);
  }
  .review-game-name :global(strong) { color: #c2410c; font-weight: 800; }

  .prose { font-size: 17px; line-height: 1.8; color: var(--text-primary); }
  @media (max-width: 899px) { .prose { margin-top: 28px; } }
  .prose > :global(* + *) { margin-top: 1.25em; }
  .prose :global(h2), .prose :global(h3) { margin-top: 2em; margin-bottom: 1em; letter-spacing: -.015em; line-height: 1.25; }
  /* section headings get a brand bar */
  .prose :global(h2) { padding-left: 14px; border-left: 4px solid var(--brand-orange); font-size: clamp(22px, 2.6vw, 28px); }
  .prose :global(h3) { font-size: 20px; color: #c2410c; }
  .prose :global(a) { color: #c2410c; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: color-mix(in oklab, var(--brand-orange) 45%, transparent); }
  .prose :global(a:hover) { text-decoration-color: currentColor; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4em; }
  .prose :global(li::marker) { color: var(--brand-orange); font-weight: 700; }
  .prose :global(li + li) { margin-top: .4em; }
  .prose :global(blockquote) { margin-inline: 0; padding: 14px 18px; border-radius: 0 16px 16px 0; border-left: 4px solid var(--brand-gold); background: color-mix(in oklab, var(--brand-gold) 14%, #fff); color: var(--text-primary); }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: 18px; }
  .prose :global(table) { width: 100%; border-collapse: separate; border-spacing: 0; overflow: hidden; border-radius: 16px; border: 1px solid color-mix(in oklab, var(--brand-orange) 20%, #fff); font-size: 15px; }
  .prose :global(th) { background: color-mix(in oklab, var(--brand-orange) 12%, #fff); text-align: left; }
  .prose :global(th), .prose :global(td) { padding: 10px 14px; border-bottom: 1px solid color-mix(in oklab, var(--brand-orange) 14%, #fff); }

  /* --- Sidebar / Summary Card --- */
  .sidebar-inner { position: sticky; top: 88px; display: grid; gap: 24px; }
  .summary-card { position: relative; overflow: hidden; background: #fff; border: 1px solid color-mix(in oklab, var(--brand-orange) 16%, #fff); border-radius: 28px; box-shadow: 0 34px 56px -36px rgba(124, 45, 18, .55); }
  .summary-image { display: block; width: 100%; aspect-ratio: 16/9; object-fit: cover; }
  .summary-content { padding: 20px; }

  /* score panel */
  .rating-box {
    position: relative; margin: -52px 0 18px; padding: 18px 14px 16px; text-align: center; color: #fff; border-radius: 22px;
    background: radial-gradient(80% 120% at 100% 0%, rgba(250, 204, 21, .35), transparent 60%), linear-gradient(150deg, #f97316 0%, #ea580c 100%);
    box-shadow: 0 22px 34px -18px rgba(124, 45, 18, .8), inset 0 1px 0 rgba(255,255,255,.35);
  }
  .rating-score { font-size: 3rem; font-weight: 850; line-height: 1; letter-spacing: -.03em; text-shadow: 0 2px 12px rgba(67, 20, 7, .3); }
  .rating-score::after { content: "/5"; margin-left: 4px; font-size: 1.1rem; font-weight: 700; opacity: .8; letter-spacing: 0; }
  .rating-stars { position: relative; display: inline-block; margin-block: 6px 4px; font-size: 1.5rem; letter-spacing: 3px; color: rgba(255, 255, 255, 0.35); }
  .rating-stars::before { content: '★★★★★'; }
  .rating-stars::after { content: '★★★★★'; position: absolute; top: 0; left: 0; color: #fef08a; width: var(--rating-percent, 0%); overflow: hidden; white-space: nowrap; }
  .rating-label { font-weight: 700; font-size: .85rem; letter-spacing: .08em; text-transform: uppercase; opacity: .95; }

  .summary-meta { margin: 0; font-size: .92rem; }
  .summary-meta > div { display: flex; justify-content: space-between; gap: 12px; padding-block: 10px; border-bottom: 1px solid color-mix(in oklab, var(--brand-orange) 14%, #fff); }
  .summary-meta > div:last-child { border-bottom: none; }
  .summary-meta dt { color: var(--text-secondary); }
  .summary-meta dd { margin: 0; font-weight: 700; text-align: right; color: var(--text-primary); }

  /* pros and cons as two tinted blocks */
  .pros-cons { margin-top: 14px; padding: 14px 16px; border-radius: 18px; }
  .pros-cons.is-pros { background: #f0fdf4; border: 1px solid #bbf7d0; }
  .pros-cons.is-cons { background: #fef2f2; border: 1px solid #fecaca; }
  .pros-cons h4 { margin: 0 0 8px; font-weight: 800; font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; }
  .is-pros h4 { color: #166534; }
  .is-cons h4 { color: #991b1b; }
  .pros-cons ul { list-style: none; margin: 0; padding: 0; font-size: .92rem; line-height: 1.5; color: var(--text-primary); }
  .pros-cons li { position: relative; padding-left: 26px; margin-bottom: 6px; }
  .pros-cons li:last-child { margin-bottom: 0; }
  .pros-cons li::before { position: absolute; left: 0; top: .1em; display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; font-size: 11px; font-weight: 800; line-height: 1; color: #fff; }
  .is-pros li::before { content: '✓'; background: #16a34a; }
  .is-cons li::before { content: '✕'; background: #dc2626; }

  @media (max-width: 767px) {
    .summary-card { border-radius: 24px; }
    .summary-content { padding: 16px; }
    .review-header h1 { font-size: clamp(26px, 8vw, 34px); }
    .prose { font-size: 16px; line-height: 1.75; }
  }
</style>
