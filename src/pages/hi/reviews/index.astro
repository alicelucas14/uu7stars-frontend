---
// ===== src/pages/hi/reviews/index.astro =====
// --- CORRECTED: Now parses Markdown in excerpts ---
import { renderMarkdown } from '@lib/renderMarkdown';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CrossLinkStrip from '../../../components/CrossLinkStrip.astro';
import MobileAppShell from '../../../components/MobileAppShell.astro';
import { getReviews } from '../../../services/api';
import type { ReviewListItem } from '../../../services/api';
import { useTranslations } from '../../../lib/i18n';
import type { Locale } from '../../../i18n';

const locale: Locale = 'hi';
const t = useTranslations(locale);

const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;
const abs = (p?: string) => (!p ? '' : (p.startsWith('http') ? p : `${API_BASE_URL}${p}`));

const allReviews = await getReviews(locale);
const reviewsWithImages = allReviews.filter(r => r.image);

const heroReview = reviewsWithImages.length > 0 ? reviewsWithImages[0] : null;
const otherReviews = reviewsWithImages.slice(1);

const pageTitle = t('reviewsIndex.title');
const pageDesc = t('reviewsIndex.description');
const h1 = t('reviewsIndex.h1');
const subheading = t('reviewsIndex.subheading');
const canonical = new URL('/hi/reviews/', Astro.site).toString();

// "4.8" style score for the badge; empty when a review has no usable rating
const score = (rating: number) => { const n = Number(rating); return Number.isFinite(n) && n > 0 ? n.toFixed(1) : ''; };
---
<Base title={pageTitle} description={pageDesc} canonical={canonical}>

  <div class="desktop-layout">
    <Header lang={locale} />
    <main class="clear-social-bar">
      <section class="reviews-index-page">
        <div class="container">
          <header class="page-head">
            <h1>{h1}</h1>
            <p class="muted" set:html={subheading}></p>
          </header>

          {heroReview && (
            <section class="hero-review-section" aria-labelledby="hero-review-title">
              <article class="hero-card">
                <div class="hero-image-wrapper">
                  <a href={`/hi/reviews/${heroReview.slug}/`} aria-label={`Read review for ${heroReview.title}`}>
                    <img src={abs(heroReview.image)} alt={`Featured image for ${heroReview.title}`} width="1200" height="600" loading="eager" />
                  </a>
                  {score(heroReview.rating) && <span class="badge badge-lg"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg>{score(heroReview.rating)}</span>}
                </div>
                <div class="hero-content">
                  <span class="game-chip">{heroReview.gameName}</span>
                  <h2 id="hero-review-title" class="hero-title"><a href={`/hi/reviews/${heroReview.slug}/`}>{heroReview.title}</a></h2>
                  <div class="hero-excerpt prose-excerpt" set:html={await renderMarkdown(heroReview.excerpt || '')} />
                  <a href={`/hi/reviews/${heroReview.slug}/`} class="hero-cta">{t('reviewsIndex.readMore')}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                </div>
              </article>
            </section>
          )}

          {otherReviews.length > 0 ? (
            <div class="grid">
              {otherReviews.map(async (r: ReviewListItem) => {
                const href = `/hi/reviews/${r.slug}/`;
                return (
                  <article class="card">
                    <a href={href} class="artlink" aria-label={`Open review ${r.title}`}>
                      <img src={abs(r.image)} alt={`Image for ${r.title}`} width="480" height="480" loading="lazy" class="cover" />
                      <span class="game-chip chip-on-img">{r.gameName}</span>
                      {score(r.rating) && <span class="badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg>{score(r.rating)}</span>}
                    </a>
                    <div class="content">
                      <h3 class="title"><a href={href}>{r.title}</a></h3>
                      <div class="card-excerpt prose-excerpt" set:html={await renderMarkdown(r.excerpt || '')} />
                      <a href={href} class="read-link" aria-label={`Open review ${r.title}`}>{t('reviewsIndex.readMore')}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                    </div>
                  </article>
                );
              })}
            </div>
          ) : !heroReview ? (
            <p class="muted">{t('reviewsIndex.noReviews')}</p>
          ) : null}
        </div>
      </section>

      <CrossLinkStrip
        lang={locale}
        showPromotions
        limitPromotions={6}
        matchTerms={['starsuu7','uu7','777','तीन पत्ती','रम्मी','बोनस','ऑफर']}
      />
    </main>
    <Footer lang={locale} />
  </div>

  <div class="mobile-layout">
    <MobileAppShell title={h1} active="faq" lang={locale}>
       <main>
        <section class="reviews-index-page">
          <div class="container">
            <div class="grid">
              {reviewsWithImages.map(async (r: ReviewListItem) => {
                const href = `/hi/reviews/${r.slug}/`;
                return (
                  <article class="card">
                    <a href={href} class="artlink" aria-label={`Open review ${r.title}`}>
                      <img src={abs(r.image)} alt="" width="480" height="480" loading="lazy" class="cover" />
                      <span class="game-chip chip-on-img">{r.gameName}</span>
                      {score(r.rating) && <span class="badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg>{score(r.rating)}</span>}
                    </a>
                    <div class="content">
                      <h3 class="title"><a href={href}>{r.title}</a></h3>
                      <div class="card-excerpt prose-excerpt" set:html={await renderMarkdown(r.excerpt || '')} />
                      <a href={href} class="read-link" aria-label={`Open review ${r.title}`}>{t('reviewsIndex.readMore')}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                    </div>
                  </article>
                );
              })}
            </div>
            {reviewsWithImages.length === 0 && <p class="muted">{t('reviewsIndex.noReviews')}</p>}
          </div>
        </section>
      </main>
    </MobileAppShell>
    <Footer lang={locale} />
  </div>
</Base>
<style>
  .desktop-layout { display: none; } .mobile-layout { display: block; } @media (min-width: 768px) { .desktop-layout { display: block; } .mobile-layout { display: none; } }
  .reviews-index-page { padding-block: 48px 64px; background: linear-gradient(180deg, color-mix(in oklab, var(--brand-orange) 5%, var(--surface)) 0%, var(--surface) 280px); border-top: 1px solid var(--ring); }
  .page-head { max-width: 760px; margin: 0 auto 36px; text-align: center; }
  .page-head h1 { margin: 0 0 14px; font-size: clamp(28px, 4.2vw, 42px); letter-spacing: -.02em; }
  .page-head h1::after { content: ""; display: block; width: 48px; height: 4px; margin: 14px auto 0; border-radius: 4px; background: linear-gradient(90deg, var(--brand-orange), var(--brand-gold)); }
  .page-head p { line-height: 1.7; }

  /* featured review */
  .hero-review-section { margin-bottom: 44px; }
  .hero-card { display: grid; grid-template-columns: 1fr; overflow: hidden; background: #fff; border: 1px solid color-mix(in oklab, var(--brand-orange) 16%, #fff); border-radius: 28px; box-shadow: 0 34px 56px -36px rgba(124, 45, 18, .55); }
  @media (min-width: 900px) { .hero-card { grid-template-columns: 1.25fr 1fr; } }
  .hero-image-wrapper { position: relative; min-height: 260px; }
  .hero-image-wrapper img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 899px) { .hero-image-wrapper { min-height: 0; aspect-ratio: 16 / 9; } }
  .hero-content { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 14px; padding: clamp(24px, 4vw, 44px); }
  .hero-title { margin: 0; font-size: clamp(24px, 2.8vw, 34px); line-height: 1.2; letter-spacing: -.02em; }
  .hero-title a { color: var(--text-primary); text-decoration: none; }
  .hero-title a:hover { color: var(--brand-orange); }
  .hero-excerpt { color: var(--text-secondary); line-height: 1.7; display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
  .hero-cta { display: inline-flex; align-items: center; gap: 10px; padding: 13px 24px; border-radius: 999px; font-weight: 800; font-size: 15px; text-decoration: none; color: #431407; background: linear-gradient(180deg, #fff3a3 0%, var(--brand-gold) 48%, #f59e0b 100%); box-shadow: 0 14px 24px -12px rgba(154, 52, 18, .6), inset 0 1px 0 rgba(255,255,255,.85), inset 0 -2px 0 rgba(180, 83, 9, .22); transition: transform .2s ease, filter .2s ease; }
  .hero-cta svg { width: 18px; height: 18px; fill: none; stroke: #9a3412; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; transition: transform .2s ease; }
  .hero-cta:hover { transform: translateY(-2px); filter: brightness(1.04); }
  .hero-cta:hover svg { transform: translateX(3px); }

  /* chips and score badge */
  .game-chip { display: inline-block; padding: 5px 12px; border-radius: 999px; font-size: 12px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: #c2410c; background: color-mix(in oklab, var(--brand-orange) 12%, #fff); border: 1px solid color-mix(in oklab, var(--brand-orange) 28%, #fff); }
  .chip-on-img { position: absolute; left: 12px; bottom: 12px; color: #431407; background: rgba(255,255,255,.92); border-color: transparent; -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); box-shadow: 0 6px 14px -8px rgba(0,0,0,.5); }
  .badge { position: absolute; top: 12px; left: 12px; z-index: 2; display: inline-flex; align-items: center; gap: 5px; padding: 5px 11px 5px 8px; border-radius: 999px; font-size: 13px; font-weight: 800; line-height: 1; color: #431407; background: linear-gradient(180deg, #fff3a3, var(--brand-gold) 60%, #f59e0b); box-shadow: 0 8px 16px -8px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.8); }
  .badge svg { width: 14px; height: 14px; fill: #b45309; stroke: #b45309; stroke-width: 1.5; stroke-linejoin: round; }
  .badge-lg { top: 18px; left: 18px; font-size: 15px; padding: 7px 14px 7px 10px; }
  .badge-lg svg { width: 16px; height: 16px; }

  /* grid of reviews */
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  @media (min-width: 768px) { .grid { grid-template-columns: repeat(3, 1fr); gap: 22px; } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(4, 1fr); } }
  .card { display: flex; flex-direction: column; overflow: hidden; background: #fff; border: 1px solid color-mix(in oklab, var(--brand-orange) 14%, #fff); border-radius: 24px; box-shadow: 0 24px 40px -30px rgba(124, 45, 18, .5); transition: transform .25s ease, box-shadow .25s ease; }
  @media (hover: hover) and (min-width: 768px) { .card:hover { transform: translateY(-6px); box-shadow: 0 34px 46px -28px rgba(124, 45, 18, .6); } .card:hover .cover { transform: scale(1.05); } }
  .artlink { position: relative; display: block; overflow: hidden; }
  .cover { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; transition: transform .5s cubic-bezier(.22,1,.36,1); }
  .content { display: flex; flex-direction: column; flex-grow: 1; gap: 8px; padding: 16px 16px 18px; }
  .title { margin: 0; font-size: 17px; line-height: 1.3; letter-spacing: -.01em; }
  .title a { color: var(--text-primary); text-decoration: none; font-weight: 800; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .title a:hover { color: var(--brand-orange); }
  .card-excerpt { flex-grow: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .read-link { display: inline-flex; align-items: center; gap: 6px; align-self: flex-start; margin-top: 4px; font-size: 14px; font-weight: 800; color: #c2410c; text-decoration: none; }
  .read-link svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; transition: transform .2s ease; }
  .read-link:hover svg { transform: translateX(4px); }

  /* STYLES FOR PARSED EXCERPT */
  .prose-excerpt { font-size: 14px; line-height: 1.6; }
  .prose-excerpt :global(p) { margin: 0 0 1em; color: var(--text-secondary); }
  .prose-excerpt :global(p:last-child) { margin-bottom: 0; }
  .prose-excerpt :global(h1), .prose-excerpt :global(h2), .prose-excerpt :global(h3), .prose-excerpt :global(h4) { font-size: 1em; font-weight: 600; color: var(--text-primary); margin: 0; }
  .prose-excerpt :global(strong) { font-weight: 700; color: var(--text-primary); }

  /* phones: a clean list of compact cards, thumbnail on the left */
  @media (max-width: 767px) {
    .reviews-index-page { padding-block: 20px 36px; border-top: none; background: var(--surface); }
    .grid { grid-template-columns: 1fr; gap: 12px; }
    .card { display: grid; grid-template-columns: 104px 1fr; align-items: stretch; border-radius: 20px; box-shadow: none; }
    .artlink { height: 100%; }
    .cover { width: 100%; height: 100%; aspect-ratio: auto; }
    .chip-on-img { display: none; }
    .badge { top: 8px; left: 8px; padding: 4px 9px 4px 7px; font-size: 12px; }
    .badge svg { width: 12px; height: 12px; }
    .content { padding: 12px 14px 12px 4px; gap: 4px; justify-content: center; }
    .title { font-size: 16px; }
    .card-excerpt { -webkit-line-clamp: 2; font-size: 13px; }
    .read-link { font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) { .card, .cover, .hero-cta, .hero-cta svg, .read-link svg { transition: none; } }
</style>
