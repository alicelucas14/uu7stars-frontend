---
// ===== src/pages/hi/blog/page/[page].astro =====
// --- REFACTORED: Now uses a consistent grid layout and renders excerpts ---
import { renderMarkdown } from '@lib/renderMarkdown';
import Base from '../../../../layouts/Base.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import MobileAppShell from '../../../../components/MobileAppShell.astro';
import { getBlogPosts } from '../../../../services/api';
import type { BlogPostListItem } from '../../../../services/api';
import { useTranslations } from '../../../../lib/i18n';
import type { Locale } from '../../../../i18n';

// This page is now dynamically generated for any /hi/blog/page/... URL.
// We removed getStaticPaths.

const locale: Locale = 'hi';
const t = useTranslations(locale);

const { page } = Astro.params;
const blogRoot = '/hi/blog/'; // Hardcoded Hindi blog root

const POSTS_PER_PAGE = Number(import.meta.env.PUBLIC_POSTS_PER_PAGE || 9);
const CURRENT_PAGE = Number.parseInt(page ?? '1', 10);

const allPosts: BlogPostListItem[] = await getBlogPosts(locale);
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));

// Redirect logic remains the same
if (Number.isNaN(CURRENT_PAGE) || CURRENT_PAGE < 1) { return Astro.redirect(blogRoot); }
if (CURRENT_PAGE === 1) { return Astro.redirect(blogRoot); }
if (CURRENT_PAGE > totalPages && totalPages > 0) { return Astro.redirect(blogRoot + `page/${totalPages}/`); }

const start = (CURRENT_PAGE - 1) * POSTS_PER_PAGE;
const pagePosts = allPosts.slice(start, start + POSTS_PER_PAGE);

const canonical = new URL(blogRoot + `page/${CURRENT_PAGE}/`, Astro.site).toString();
const prevUrl = CURRENT_PAGE > 1 ? new URL(CURRENT_PAGE === 2 ? blogRoot : blogRoot + `page/${CURRENT_PAGE - 1}/`, Astro.site).toString() : undefined;
const nextUrl = CURRENT_PAGE < totalPages ? new URL(blogRoot + `page/${CURRENT_PAGE + 1}/`, Astro.site).toString() : undefined;

const pageTitle = t('blogPaginated.title').replace('{currentPage}', String(CURRENT_PAGE));
const pageDescription = t('blogPaginated.description');
const h1 = t('blogPaginated.h1');
const firstPageText = t('blogPaginated.firstPage');

// the label strings may already end in an arrow; the button draws its own
const noArrow = (txt: string) => String(txt).replace(/\s*(?:→|&rarr;|›|»)+\s*$/u, '');
const formatDate = (date: string) => new Date(date).toLocaleDateString('hi-IN', { year: 'numeric', month: 'long', day: 'numeric' });

const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;
const toAbsolute = (p?: string) => !p ? '' : (p.startsWith('http') ? p : new URL(p, API_BASE_URL).toString());
---
<Base title={pageTitle} description={pageDescription} canonical={canonical} prevUrl={prevUrl} nextUrl={nextUrl} lang={locale}>

  <div class="header-slot">
    <Header lang={locale} />
  </div>
  <div class="mobile-layout">
    <MobileAppShell title={`${h1} - पृष्ठ ${CURRENT_PAGE}`} active="blog" lang={locale} />
  </div>

  <main class="blog-index clear-social-bar">
    <div class="container">
      <header class="section-head">
        <div>
          <h1>{h1}</h1>
          <p class="muted">{t('blogIndex.pager.pageStatus').replace('{currentPage}', String(CURRENT_PAGE)).replace('{totalPages}', String(totalPages))}</p>
        </div>
        <a href={blogRoot} class="btn-view-all" aria-label="Go to page 1">{firstPageText}</a>
      </header>

      {pagePosts.length === 0 ? ( <p class="muted">{t('blogPaginated.noPosts')}</p> ) : (
        <div class="post-grid">
          {pagePosts.map(async (post) => {
            const postUrl = blogRoot + `${post.slug}/`;
            return (
              <article class="post-card">
                <a href={postUrl} class="card-image-link" aria-label={`Read more: ${post.title}`}>
                  <img src={toAbsolute(post.image)} alt={`Featured image for ${post.title}`} loading="lazy" width="400" height="250" class="card-image"/>
                    <time class="date-chip" datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
                </a>
                <div class="card-content">
                  <h2 class="card-title"><a href={postUrl}>{post.title}</a></h2>
                  <div class="card-excerpt prose-excerpt" set:html={await renderMarkdown(post.excerpt || '')} />
                    <a href={postUrl} class="read-link" aria-label={`Read more about ${post.title}`}>{noArrow(t('recentBlogs.readMore'))}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                </div>
              </article>
            );
          })}
        </div>
      )}

      <nav class="pager" aria-label="Pagination">
        <ul>
          <li class="desktop-layout"><a class="pg-btn" href={blogRoot} aria-label="Go to first page">« {firstPageText}</a></li>
          <li>{prevUrl ? (<a class="pg-btn" href={prevUrl} aria-label="Previous page">{t('blogIndex.pager.prev')}</a>) : (<span class="pg-btn" aria-disabled="true">{t('blogIndex.pager.prev')}</span>)}</li>
          <li class="pg-status" aria-current="page">{t('blogIndex.pager.pageStatus').replace('{currentPage}', String(CURRENT_PAGE)).replace('{totalPages}', String(totalPages))}</li>
          <li>{nextUrl ? (<a class="pg-btn" href={nextUrl} aria-label="Next page">{t('blogIndex.pager.next')}</a>) : (<span class="pg-btn" aria-disabled="true">{t('blogIndex.pager.next')}</span>)}</li>
          <li class="desktop-layout">{CURRENT_PAGE < totalPages ? (<a class="pg-btn" href={blogRoot + `page/${totalPages}/`} aria-label="Go to last page">{t('blogIndex.pager.last')}</a>) : (<span class="pg-btn" aria-disabled="true">{t('blogIndex.pager.last')}</span>)}</li>
        </ul>
        <ol class="pg-numbers">
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
            <li>{n === CURRENT_PAGE ? (<span class="pg-num is-current" aria-current="page">{n}</span>) : (<a class="pg-num" href={n === 1 ? blogRoot : blogRoot + `page/${n}/`}>{n}</a>)}</li>
          ))}
        </ol>
      </nav>
    </div>
  </main>

  <Footer lang={locale} />
</Base>

<style>
  /* Styles are identical to English version */
 .desktop-layout { display: none; }
 .mobile-layout { display: block; }
 @media (min-width: 768px) {
    .desktop-layout { display: block; }
    .mobile-layout { display: none; }
 }
 .pager .desktop-layout { display: none; }
 @media (min-width: 768px) {
    .pager .desktop-layout { display: inline-flex; }
 }
 .blog-index { padding-block: 48px; background-color: var(--surface); border-top: 1px solid var(--ring); }
 @media (max-width: 767px) {
    .blog-index { padding-block: 24px; border-top: none; }
    .mobile-layout + .blog-index { padding-top: 0; }
 }
 .section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 24px; }
 .section-head h1 { font-size: clamp(24px, 4vw, 36px); margin: 0 0 4px; }
 .btn-view-all { display: inline-block; padding: 10px 16px; font-size: 14px; font-weight: 600; color: var(--text-primary); background-color: var(--surface-2); border: 1px solid var(--ring); border-radius: 10px; text-decoration: none; }
 .btn-view-all:hover { background-color: var(--surface); }
 .post-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 12px; }
 @media (max-width: 767px) { .post-grid { grid-template-columns: 1fr; } }
 .post-card { background-color: var(--surface); border: 1px solid var(--ring); border-radius: 18px; overflow: hidden; box-shadow: var(--shadow-md); transition: transform .2s ease-out, box-shadow .2s ease-out; display: flex; flex-direction: column; }
 .post-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); }
 .card-image-link { display: block; }
 .card-image { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
 .card-content { padding: 20px; display: flex; flex-direction: column; flex-grow: 1; }
 .card-meta { font-size: 13px; color: var(--text-secondary); margin-bottom: 8px; }
 .card-title { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
 .card-title a { color: var(--text-primary); text-decoration: none; }
 .card-title a:hover { color: var(--brand-orange); }
 .card-excerpt { font-size: 14px; line-height: 1.6; color: var(--text-secondary); margin: 0; flex-grow: 1; }
 .prose-excerpt { font-size: 14px; line-height: 1.6; }
 .prose-excerpt :global(p) { margin: 0 0 1em; color: var(--text-secondary); }
 .prose-excerpt :global(p:last-child) { margin-bottom: 0; }
 .prose-excerpt :global(h1), .prose-excerpt :global(h2), .prose-excerpt :global(h3), .prose-excerpt :global(h4) { font-size: 1em; font-weight: 600; color: var(--text-primary); margin: 0; }
 .prose-excerpt :global(strong) { font-weight: 700; color: var(--text-primary); }
 .pager { margin-top: 28px; }
 .pager ul { list-style: none; padding: 0; margin: 0; display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; align-items: center; }
 .pg-btn { display: inline-flex; align-items: center; justify-content: center; min-width: 72px; height: 36px; padding: 0 12px; border-radius: 10px; border: 1px solid var(--ring); background: var(--surface-2); color: var(--text-primary); font-weight: 700; text-decoration: none; }
 .pg-btn[aria-disabled="true"] { opacity: .6; pointer-events: none; }
 .pg-status { font-weight: 700; color: var(--text-secondary); padding: 6px 8px; }
 .pg-numbers { list-style: none; padding: 0; margin: 14px 0 0; display: flex; justify-content: center; gap: 6px; flex-wrap: wrap; }
 .pg-num { display: inline-flex; align-items: center; justify-content: center; min-width: 36px; height: 36px; padding: 0 8px; border-radius: 10px; border: 1px solid var(--ring); background: var(--surface); color: var(--text-primary); font-weight: 700; text-decoration: none; }
 a.pg-num:hover { background: var(--surface-2); }
 .pg-num.is-current { background: var(--brand-orange); border-color: var(--brand-orange); color: #fff; }

  /* ================= modern look, shared with the rest of the site ================= */
  .blog-index-page, .blog-index { padding-block: 56px 80px; background: linear-gradient(180deg, color-mix(in oklab, var(--brand-orange) 6%, var(--surface)) 0%, var(--surface) 360px); }
  @media (max-width: 767px) { .blog-index-page, .blog-index { padding-block: 24px 48px; } }
  .page-header h1, .section-head h1 { font-size: clamp(28px, 4.2vw, 42px); letter-spacing: -.02em; }
  .page-header h1::after { content: ""; display: block; width: 48px; height: 4px; margin: 14px auto 0; border-radius: 4px; background: linear-gradient(90deg, var(--brand-orange), var(--brand-gold)); }

  /* featured post */
  .hero-card { position: relative; overflow: hidden; border: 1px solid color-mix(in oklab, var(--brand-orange) 20%, #fff); border-radius: 32px; background: linear-gradient(135deg, #fff 0%, color-mix(in oklab, var(--brand-orange) 7%, #fff) 100%); box-shadow: 0 40px 64px -40px rgba(124, 45, 18, .6); }
  .hero-image-wrapper { position: relative; overflow: hidden; }
  .hero-image-wrapper img { display: block; transition: transform .6s cubic-bezier(.22,1,.36,1); }
  @media (hover: hover) and (min-width: 768px) { .hero-card:hover .hero-image-wrapper img { transform: scale(1.04); } }
  .hero-content { gap: 0; }
  .hero-meta { margin: 0 0 14px; }
  .hero-meta time { display: inline-block; padding: 5px 13px; border-radius: 999px; font-size: 12.5px; font-weight: 800; letter-spacing: .04em; color: #c2410c; background: color-mix(in oklab, var(--brand-orange) 12%, #fff); border: 1px solid color-mix(in oklab, var(--brand-orange) 28%, #fff); }
  .hero-title { font-size: clamp(26px, 3vw, 38px); line-height: 1.15; letter-spacing: -.025em; }
  .hero-excerpt { padding-left: 16px; border-left: 3px solid color-mix(in oklab, var(--brand-orange) 45%, #fff); display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; flex-grow: 0; }
  .hero-cta { display: inline-flex; align-items: center; gap: 10px; padding: 14px 28px; border-radius: 999px; font-weight: 800; font-size: 15px; color: #431407; background: linear-gradient(180deg, #fff3a3 0%, var(--brand-gold) 48%, #f59e0b 100%); box-shadow: 0 14px 24px -12px rgba(154, 52, 18, .6), inset 0 1px 0 rgba(255,255,255,.85), inset 0 -2px 0 rgba(180, 83, 9, .22); transition: transform .2s ease, filter .2s ease; }
  .hero-cta:hover { text-decoration: none; transform: translateY(-2px); filter: brightness(1.04); }
  .hero-cta svg, .read-link svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; transition: transform .2s ease; }
  .hero-cta svg { stroke: #9a3412; }
  .hero-cta:hover svg { transform: translateX(3px); }

  /* post cards */
  .post-grid { gap: 24px; }
  .post-card { display: flex; flex-direction: column; border: 1px solid color-mix(in oklab, var(--brand-orange) 14%, #fff); border-radius: 24px; background: #fff; box-shadow: 0 24px 40px -30px rgba(124, 45, 18, .5); transition: transform .25s ease, box-shadow .25s ease; }
  .post-card:hover { transform: none; box-shadow: 0 24px 40px -30px rgba(124, 45, 18, .5); }
  @media (hover: hover) and (min-width: 768px) { .post-card:hover { transform: translateY(-6px); box-shadow: 0 34px 46px -28px rgba(124, 45, 18, .6); } .post-card:hover .card-image { transform: scale(1.05); } }
  .card-image-link { position: relative; display: block; overflow: hidden; }
  .card-image { display: block; transition: transform .5s cubic-bezier(.22,1,.36,1); }
  .date-chip { position: absolute; left: 12px; bottom: 12px; padding: 5px 11px; border-radius: 999px; font-size: 12px; font-weight: 700; color: #431407; background: rgba(255,255,255,.92); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); box-shadow: 0 6px 14px -8px rgba(0,0,0,.5); }
  .card-content { padding: 20px 20px 22px; }
  .card-title { margin: 0 0 8px; font-size: 19px; line-height: 1.3; font-weight: 800; letter-spacing: -.01em; }
  .card-title a { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .card-excerpt { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .read-link { display: inline-flex; align-items: center; gap: 6px; align-self: flex-start; margin-top: 16px; font-size: 14px; font-weight: 800; color: #c2410c; text-decoration: none; }
  .read-link:hover svg { transform: translateX(4px); }

  /* pager: brand pills */
  .pager .pg-btn { border-radius: 999px; background: #fff; border: 1.5px solid color-mix(in oklab, var(--brand-orange) 40%, #fff); color: #c2410c; font-weight: 800; }
  .pager a.pg-btn:hover { background: var(--brand-orange); border-color: var(--brand-orange); color: #fff; }
  .pager .pg-num { border-radius: 999px; background: #fff; border-color: color-mix(in oklab, var(--brand-orange) 22%, #fff); color: var(--text-primary); }
  .pager a.pg-num:hover { background: color-mix(in oklab, var(--brand-orange) 10%, #fff); }
  .pager .pg-num.is-current { background: linear-gradient(135deg, #fb923c, var(--brand-orange) 55%, #ea580c); border-color: var(--brand-orange); color: #fff; box-shadow: 0 10px 18px -10px rgba(234, 88, 12, .8); }
  .btn-view-all { border-radius: 999px; font-weight: 800; color: #c2410c; background: #fff; border: 1.5px solid color-mix(in oklab, var(--brand-orange) 45%, #fff); }
  .btn-view-all:hover { color: #fff; background: var(--brand-orange); border-color: var(--brand-orange); }
  @media (prefers-reduced-motion: reduce) { .post-card, .card-image, .hero-image-wrapper img, .hero-cta { transition: none; } }
</style>