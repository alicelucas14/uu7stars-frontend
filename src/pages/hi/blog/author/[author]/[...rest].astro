---
// ===== src/pages/hi/blog/author/[author].astro =====
// --- CORRECTED: Now parses Markdown in excerpts ---
import { renderMarkdown } from '@lib/renderMarkdown';
import Base from '../../../../../layouts/Base.astro';
import Header from '../../../../../components/Header.astro';
import Footer from '../../../../../components/Footer.astro';
import MobileAppShell from '../../../../../components/MobileAppShell.astro';
import { getBlogPosts } from '../../../../../services/api';
import type { BlogPostListItem } from '../../../../../services/api';
import { slugify } from '../../../../../lib/paths';
import { useTranslations } from '../../../../../lib/i18n';

// This is an SSR page, getStaticPaths is removed.

const locale: 'hi' = 'hi';
const t = useTranslations(locale);
const { author: authorSlug, rest } = Astro.params;

// /author/x/ is page 1; /author/x/page/N/ is page N (20 posts per page). Anything else is a 404.
const POSTS_PER_PAGE = 20;
const pageMatch = rest === undefined ? null : /^page\/(\d+)$/.exec(rest);
if (rest !== undefined && !pageMatch) return new Response(null, { status: 404, statusText: 'Not Found' });
const CURRENT_PAGE = pageMatch ? Number(pageMatch[1]) : 1;
const authorRoot = `/hi/blog/author/${authorSlug}/`;
const pageUrlPath = (n: number) => (n <= 1 ? authorRoot : `${authorRoot}page/${n}/`);

const allPosts = await getBlogPosts(locale);

const filteredPosts = allPosts.filter(p => slugify(p.author) === authorSlug);

const totalPages = Math.max(1, Math.ceil(filteredPosts.length / POSTS_PER_PAGE));
if (rest !== undefined && filteredPosts.length === 0) return new Response(null, { status: 404, statusText: 'Not Found' });
if (rest !== undefined && (CURRENT_PAGE === 1 || CURRENT_PAGE < 1)) return Astro.redirect(authorRoot, 301);
if (CURRENT_PAGE > totalPages) return Astro.redirect(pageUrlPath(totalPages), 301);
const pagePosts = filteredPosts.slice((CURRENT_PAGE - 1) * POSTS_PER_PAGE, CURRENT_PAGE * POSTS_PER_PAGE);

const authorName = filteredPosts.length > 0 ? filteredPosts[0].author : authorSlug;

const pageTitle = `${authorName} द्वारा पोस्ट${CURRENT_PAGE > 1 ? ` - पृष्ठ ${CURRENT_PAGE}` : ''} | Starsuu7 ब्लॉग`;
const pageDescription = `Starsuu7 ब्लॉग पर ${authorName} द्वारा लिखे गए सभी ब्लॉग पोस्ट और लेख खोजें।`;
const h1 = `लेखक: ${authorName}`;
const canonical = new URL(pageUrlPath(CURRENT_PAGE), Astro.site).toString();
const prevUrl = CURRENT_PAGE > 1 ? new URL(pageUrlPath(CURRENT_PAGE - 1), Astro.site).toString() : undefined;
const nextUrl = CURRENT_PAGE < totalPages ? new URL(pageUrlPath(CURRENT_PAGE + 1), Astro.site).toString() : undefined;

const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;
const toAbsolute = (p?: string) => !p ? '' : (p.startsWith('http') ? p : new URL(p, API_BASE_URL).toString());
const formatDate = (date: string) => new Date(date).toLocaleDateString('hi-IN', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={pageTitle} description={pageDescription} canonical={canonical} prevUrl={prevUrl} nextUrl={nextUrl} lang={locale}>

  <div class="header-slot"><Header lang={locale} /></div>
  <div class="mobile-layout"><MobileAppShell title={h1} active="blog" lang={locale} showBack={true} /></div>

  <main class="blog-archive-page clear-social-bar">
    <div class="container">
      <header class="page-header">
        <p class="archive-type">ब्लॉग आर्काइव</p>
        <h1>{h1}</h1>
      </header>

      {filteredPosts.length > 0 ? (
        <div class="post-grid">
          {pagePosts.map(async (post: BlogPostListItem) => {
            const postUrl = `/hi/blog/${post.slug}/`;
            return (
              <article class="post-card">
                <a href={postUrl} class="card-image-link" aria-label={`पढ़ें: ${post.title}`}>
                  <img src={toAbsolute(post.image)} alt={`के लिए विशेष रुप से प्रदर्शित छवि ${post.title}`} loading="lazy" width="400" height="250" class="card-image" />
                </a>
                <div class="card-content">
                  <p class="card-meta"><time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time></p>
                  <h2 class="card-title"><a href={postUrl}>{post.title}</a></h2>
                  <div class="card-excerpt prose-excerpt" set:html={await renderMarkdown(post.excerpt || '')} />
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <p>इस लेखक के लिए कोई पोस्ट नहीं मिली।</p>
      )}

      {totalPages > 1 && (
        <nav class="pager" aria-label="Pagination">
          <ul>
            <li class="desktop-layout"><a class="pg-btn" href={pageUrlPath(1)} aria-label="Go to first page">« 1</a></li>
            <li>{prevUrl ? (<a class="pg-btn" href={pageUrlPath(CURRENT_PAGE - 1)} aria-label="Previous page">{t('blogIndex.pager.prev')}</a>) : (<span class="pg-btn" aria-disabled="true">{t('blogIndex.pager.prev')}</span>)}</li>
            <li class="pg-status" aria-current="page">{t('blogIndex.pager.pageStatus').replace('{currentPage}', String(CURRENT_PAGE)).replace('{totalPages}', String(totalPages))}</li>
            <li>{nextUrl ? (<a class="pg-btn" href={pageUrlPath(CURRENT_PAGE + 1)} aria-label="Next page">{t('blogIndex.pager.next')}</a>) : (<span class="pg-btn" aria-disabled="true">{t('blogIndex.pager.next')}</span>)}</li>
            <li class="desktop-layout">{CURRENT_PAGE < totalPages ? (<a class="pg-btn" href={pageUrlPath(totalPages)} aria-label="Go to last page">{t('blogIndex.pager.last')}</a>) : (<span class="pg-btn" aria-disabled="true">{t('blogIndex.pager.last')}</span>)}</li>
          </ul>
          <ol class="pg-numbers">
            {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
              <li>{n === CURRENT_PAGE ? (<span class="pg-num is-current" aria-current="page">{n}</span>) : (<a class="pg-num" href={pageUrlPath(n)}>{n}</a>)}</li>
            ))}
          </ol>
        </nav>
      )}
    </div>
  </main>
  
  <Footer lang={locale} />
</Base>

<style>
  /* Styles are identical to English version */
  .desktop-layout { display: none; } .mobile-layout { display: block; } @media (min-width: 768px) { .desktop-layout { display: block; } .mobile-layout { display: none; } }
  .blog-archive-page { padding-block: 48px; }
  @media (max-width: 767px) { .blog-archive-page { padding-block: 24px; } .mobile-layout + .blog-archive-page { padding-top: 0; } }
  .page-header { text-align: center; margin-bottom: 36px; }
  .archive-type { color: var(--brand-orange); font-weight: 700; margin-bottom: 8px; }
  .page-header h1 { font-size: clamp(28px, 4vw, 40px); margin-bottom: 8px; text-transform: capitalize; }
  .post-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px; }
  @media (max-width: 767px) { .post-grid { grid-template-columns: 1fr; gap: 24px; } }
  .post-card { background-color: var(--surface); border: 1px solid var(--ring); border-radius: 18px; overflow: hidden; box-shadow: var(--shadow-md); transition: transform .2s ease-out, box-shadow .2s ease-out; display: flex; flex-direction: column; }
  .post-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); }
  .card-image-link { display: block; }
  .card-image { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .card-content { padding: 20px; display: flex; flex-direction: column; flex-grow: 1; }
  .card-meta { font-size: 13px; color: var(--text-secondary); margin-bottom: 12px; }
  .card-title { font-size: 18px; margin-bottom: 8px; }
  .card-title a { color: var(--text-primary); text-decoration: none; }
  .card-title a:hover { color: var(--brand-orange); }
  .card-excerpt { font-size: 14px; line-height: 1.6; color: var(--text-secondary); margin: 0; flex-grow: 1; }

  .pager { margin-top: 28px; }
  .pager .desktop-layout { display: none; }
  @media (min-width: 768px) { .pager .desktop-layout { display: inline-flex; } }
  .pager ul { list-style: none; padding: 0; margin: 0; display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; align-items: center; }
  .pg-btn { display: inline-flex; align-items: center; justify-content: center; min-width: 72px; height: 36px; padding: 0 12px; border-radius: 10px; border: 1px solid var(--ring); background: var(--surface-2); color: var(--text-primary); font-weight: 700; text-decoration: none; }
  .pg-btn[aria-disabled="true"] { opacity: .6; pointer-events: none; }
  .pg-status { font-weight: 700; color: var(--text-secondary); padding: 6px 8px; }
  .pg-numbers { list-style: none; padding: 0; margin: 14px 0 0; display: flex; justify-content: center; gap: 6px; flex-wrap: wrap; }
  .pg-num { display: inline-flex; align-items: center; justify-content: center; min-width: 36px; height: 36px; padding: 0 8px; border-radius: 10px; border: 1px solid var(--ring); background: var(--surface); color: var(--text-primary); font-weight: 700; text-decoration: none; }
  a.pg-num:hover { background: var(--surface-2); }
  .pg-num.is-current { background: var(--brand-orange); border-color: var(--brand-orange); color: #fff; }
  /* STYLES FOR PARSED EXCERPT */
  .prose-excerpt { font-size: 14px; line-height: 1.6; }
  .prose-excerpt :global(p) { margin: 0 0 1em; color: var(--text-secondary); }
  .prose-excerpt :global(p:last-child) { margin-bottom: 0; }
  .prose-excerpt :global(h1), .prose-excerpt :global(h2), .prose-excerpt :global(h3), .prose-excerpt :global(h4) { font-size: 1em; font-weight: 600; color: var(--text-primary); margin: 0; }
  .prose-excerpt :global(strong) { font-weight: 700; color: var(--text-primary); }
</style>